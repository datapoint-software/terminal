#!/bin/sh
# Stops a commit whose added lines hold a secret or a real host name or address. Turn it on once per clone with:
#   git config core.hooksPath .githooks
here=$(dirname "$0")
git diff --cached --no-color --no-ext-diff -U0 --diff-filter=ACMR \
    | awk -v mode=diff -v allowed="$here/allowed" -v forbidden="$(git rev-parse --git-path info/forbidden)" -f "$here/check.awk"
