<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:Datapoint.Terminal.Editor"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             xmlns:c="clr-namespace:Datapoint.Terminal.Components"
             x:Class="Datapoint.Terminal.Editor.ServerFileView"
             x:DataType="ed:ServerFileViewModel"
             Background="{DynamicResource WindowBrush}">

  <DockPanel>
    <!-- Where the file is, as a host document's header shows its host. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Classes="plain" Content="{res:Tr HostFileRevert}" Command="{Binding RevertCommand}" />
          <Button Classes="primary" Content="{res:Tr HostFileReviewSave}" Command="{Binding SaveCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <c:Badge Text="{Binding Environment}" Classes.danger="{Binding IsProduction}" IsVisible="{Binding HasEnvironment}" />
          <TextBlock Text="{Binding Place}" Classes="mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{res:Tr HostFileNeedsSudo}" IsVisible="{Binding NeedsSudo}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="14,4">
        <TextBlock DockPanel.Dock="Right" Classes="secondary" VerticalAlignment="Center" Text="{Binding StatusRight}" />
        <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding StatusLeft}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <ae:TextEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource BodySize}"
                   Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource LabelBrush}"
                   LineNumbersForeground="{DynamicResource DisabledLabelBrush}"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="{Binding Name}" />
  </DockPanel>
</UserControl>
