<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:Datapoint.Terminal.Editor"
             xmlns:md="clr-namespace:Datapoint.Terminal.Markdown"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             xmlns:c="clr-namespace:Datapoint.Terminal.Components"
             x:Class="Datapoint.Terminal.Editor.DocumentView"
             x:DataType="ed:DocumentViewModel"
             Background="{DynamicResource WindowBrush}" Focusable="True">
  <UserControl.Styles>
    <Style Selector="TextBox.number">
      <Setter Property="Width" Value="64" />
      <Setter Property="MaxLength" Value="6" />
    </Style>
    <Style Selector="Button.chipRemove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="{StaticResource BodySize}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <!-- The block being edited: no field around it, so it reads as the same text, now as Markdown. -->
    <Style Selector="TextBox.block">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBox.block.code">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="LineHeight" Value="NaN" />
    </Style>
    <Style Selector="TextBox.block.code /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource CodeBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource BlockRadius}" />
    </Style>
    <Style Selector="TextBox.block.code:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource CodeBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource BlockRadius}" />
    </Style>
    <Style Selector="TextBox.source">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource BodySize}" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="AcceptsTab" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- The agent, or another program, changed the file while the user had changes not yet saved: the user picks one. -->
    <Border DockPanel.Dock="Top" Classes="bar warning" IsVisible="{Binding HasConflict}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{res:Tr DocumentTakeTheirs}" Command="{Binding TakeTheirsCommand}" />
          <Button Classes="primary" Content="{res:Tr DocumentKeepMine}" Command="{Binding KeepMineCommand}" />
        </StackPanel>
        <TextBlock Text="{res:Tr DocumentConflict}" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="bar warning" IsVisible="{Binding HasProblem}">
      <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
    </Border>
    <Panel>
      <ScrollViewer x:Name="Scroller" IsVisible="{Binding IsRichMode}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Page" MaxWidth="680" Margin="40,32,40,0">
          <!-- A host's documentation starts with the host: where it is and whether a terminal is open on it. -->
          <DockPanel IsVisible="{Binding HasHost}" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Classes="primary" Content="{res:Tr DocumentOpenTerminal}" Command="{Binding Host.OpenTerminalCommand, FallbackValue={x:Null}}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Content="{res:Tr DocumentEditHost}" Command="{Binding Host.EditCommand, FallbackValue={x:Null}}"
                    IsVisible="{Binding Host.CanEdit, FallbackValue=False}" VerticalAlignment="Center" />
            <WrapPanel ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
              <c:Badge Text="{Binding Host.Environment, FallbackValue={x:Null}}" IsVisible="{Binding Host.HasEnvironment, FallbackValue=False}"
                       Classes.danger="{Binding Host.IsProduction, FallbackValue=False}" />
              <ItemsControl ItemsSource="{Binding Host.Labels, FallbackValue={x:Null}}" IsVisible="{Binding Host.HasLabels, FallbackValue=False}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <c:Badge Classes="outline" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="mono quiet" Text="{Binding Host.Address, FallbackValue={x:Null}}" IsVisible="{Binding Host.HasAddress, FallbackValue=False}" VerticalAlignment="Center" />
              <TextBlock Classes="secondary" Text="{Binding Host.OpenText, FallbackValue={x:Null}}" IsVisible="{Binding Host.HasOpenText, FallbackValue=False}" VerticalAlignment="Center" />
            </WrapPanel>
          </DockPanel>
          <!-- A skill's page starts with where it runs and how it rolls out, written to its header as the user changes them. -->
          <ContentControl Content="{Binding Skill}" IsVisible="{Binding HasSkill}" Margin="0,0,0,24">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="ed:SkillHeaderViewModel">
                <StackPanel Spacing="14">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="primary" Content="{Binding RunText}" Command="{Binding RunCommand}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <c:Badge Text="{res:Tr SkillBadge}" />
                      <TextBlock Classes="secondary" Text="{Binding Location}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="heading" Margin="0" Text="{res:Tr SkillDescription}" />
                    <TextBox Classes="skillField" Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="False" MaxLength="1024" IsEnabled="{Binding CanWrite}"
                             PlaceholderText="{res:Tr SkillDescriptionHint}" AutomationProperties.Name="{res:Tr SkillDescription}" />
                  </StackPanel>
                  <TextBlock Classes="heading" Margin="0" Text="{res:Tr SkillHowItRollsOut}" />
                  <Border Classes="group" IsEnabled="{Binding CanWrite}">
                    <StackPanel>
                      <Grid Classes="row" ColumnDefinitions="140,*">
                        <TextBlock Text="{res:Tr SkillRunsOn}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                          <WrapPanel ItemSpacing="6" LineSpacing="6">
                            <ItemsControl ItemsSource="{Binding Labels}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="8,1,2,1">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                      <TextBlock Text="{Binding}" FontSize="{StaticResource SmallSize}" VerticalAlignment="Center" />
                                      <Button Classes="chipRemove" Content="×" CommandParameter="{Binding}"
                                              Command="{Binding $parent[ContentControl].((ed:SkillHeaderViewModel)DataContext).RemoveLabelCommand}"
                                              AutomationProperties.Name="{res:Tr SkillRemoveLabel, Argument={Binding}}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="NewLabelBox" Classes="label" Text="{Binding NewLabel}" Width="120" MaxLength="40"
                                     PlaceholderText="{res:Tr SkillAddLabel}" AutomationProperties.Name="{res:Tr SkillAddLabel}" />
                          </WrapPanel>
                          <TextBlock Classes="secondary" Text="{Binding MatchText}" />
                        </StackPanel>
                      </Grid>
                      <Rectangle Classes="hairline" />
                      <Grid Classes="row" ColumnDefinitions="140,*">
                        <TextBlock Text="{res:Tr SkillOrder}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                          <ListBox Classes="segmented" ItemsSource="{Binding OrderChoices}" SelectedIndex="{Binding OrderIndex}"
                                   AutomationProperties.Name="{res:Tr SkillOrder}" />
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBatches}">
                            <TextBox Classes="skillField number" Text="{Binding BatchSize}" AutomationProperties.Name="{res:Tr SkillBatchSize}" />
                            <TextBlock Classes="secondary" Text="{res:Tr SkillBatchSize}" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsAllAtOnce}">
                            <TextBox Classes="skillField number" Text="{Binding MaxHosts}" AutomationProperties.Name="{res:Tr SkillMaxHosts}" />
                            <TextBlock Classes="secondary" Text="{res:Tr SkillMaxHosts}" VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <Rectangle Classes="hairline" />
                      <Grid Classes="row" ColumnDefinitions="140,*">
                        <TextBlock Text="{res:Tr SkillHealthCheck}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBox Classes="skillField" Text="{Binding HealthCheck}" FontFamily="{StaticResource MonoFont}" MaxLength="500"
                                   AutomationProperties.Name="{res:Tr SkillHealthCheck}" />
                          <TextBlock Classes="secondary" Text="{res:Tr SkillHealthCheckHint}" />
                        </StackPanel>
                      </Grid>
                      <Rectangle Classes="hairline" IsVisible="{Binding HasHealthCheck}" />
                      <Grid Classes="row" ColumnDefinitions="140,*" IsVisible="{Binding HasHealthCheck}">
                        <TextBlock Text="{res:Tr SkillHealthyFor}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <TextBox Classes="skillField number" Text="{Binding HealthyFor}" AutomationProperties.Name="{res:Tr SkillHealthyFor}" />
                          <TextBlock Classes="secondary" Text="{res:Tr SkillHealthyForUnit}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                      <Rectangle Classes="hairline" />
                      <Grid Classes="row" ColumnDefinitions="140,*">
                        <TextBlock Text="{res:Tr SkillGiveUpAfter}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <TextBox Classes="skillField number" Text="{Binding Timeout}" AutomationProperties.Name="{res:Tr SkillGiveUpAfter}" />
                          <TextBlock Classes="secondary" Text="{res:Tr SkillGiveUpAfterUnit}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                      <Rectangle Classes="hairline" />
                      <Grid Classes="row" ColumnDefinitions="140,*">
                        <TextBlock Text="{res:Tr SkillOnFailure}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                          <ComboBox ItemsSource="{Binding FailureChoices}" SelectedIndex="{Binding FailureIndex}" MinWidth="240"
                                    AutomationProperties.Name="{res:Tr SkillOnFailure}" />
                          <TextBlock Classes="secondary" Text="{Binding FailureHint}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="secondary danger" Text="{Binding Problem}" IsVisible="{Binding HasProblem}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ItemsControl x:Name="BlockList" ItemsSource="{Binding Blocks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ed:BlockViewModel">
                <Panel IsVisible="{Binding IsShown}" Margin="{Binding Spacing}">
                  <md:MarkdownView IsDocument="True" Text="{Binding Body}" IsVisible="{Binding IsRendered}" Cursor="Ibeam" />
                  <TextBox Classes="bare block" Classes.code="{Binding IsCode}" Text="{Binding Body}" IsVisible="{Binding IsEditing}"
                           FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}">
                    <TextBox.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="{res:Tr MenuBold}" Click="OnBoldClicked" />
                        <MenuItem Header="{res:Tr MenuItalic}" Click="OnItalicClicked" />
                        <MenuItem Header="{res:Tr MenuInlineCode}" Click="OnCodeClicked" />
                        <MenuItem Header="{res:Tr MenuLink}" Click="OnLinkClicked" />
                        <Separator />
                        <MenuItem Header="{res:Tr MenuCut}" Command="{Binding $parent[TextBox].Cut}" />
                        <MenuItem Header="{res:Tr MenuCopy}" Command="{Binding $parent[TextBox].Copy}" />
                        <MenuItem Header="{res:Tr MenuPaste}" Command="{Binding $parent[TextBox].Paste}" />
                      </MenuFlyout>
                    </TextBox.ContextFlyout>
                  </TextBox>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Below the last block: a click starts a new paragraph at the end. -->
          <Panel x:Name="EndArea" Background="Transparent" MinHeight="{Binding EndAreaHeight}" Cursor="Ibeam">
            <TextBlock Classes="quiet" Text="{res:Tr DocumentPlaceholder}" IsVisible="{Binding IsEmpty}" FontSize="{StaticResource ReadingSize}"
                       VerticalAlignment="Top" IsHitTestVisible="False" />
          </Panel>
          <!-- The host's maintenance log: one file per entry in log/, shown here rather than as part of the document. -->
          <StackPanel IsVisible="{Binding HasHost}" Margin="0,0,0,40">
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Classes="plain" Content="{Binding Host.ShowAllText, FallbackValue={x:Null}}"
                      IsVisible="{Binding Host.CanShowAll, FallbackValue=False}" Command="{Binding Host.ToggleLogCommand, FallbackValue={x:Null}}" />
              <TextBlock Classes="pageHeading" Text="{res:Tr DocumentLogHeading}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="quiet" Text="{res:Tr DocumentLogNone}" IsVisible="{Binding !Host.HasLog, FallbackValue=False}" TextWrapping="Wrap" />
            <Border Classes="list" IsVisible="{Binding Host.HasLog, FallbackValue=False}">
              <ItemsControl ItemsSource="{Binding Host.LogEntries, FallbackValue={x:Null}}" AutomationProperties.Name="{Binding Host.LogHeading, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ed:HostLogItem">
                    <Border Classes="listItem" Padding="16,10" AutomationProperties.Name="{Binding AccessibleName}">
                      <Grid ColumnDefinitions="160,*" ColumnSpacing="16">
                        <StackPanel>
                          <TextBlock Classes="quiet" Text="{Binding When}" />
                          <TextBlock Classes="secondary" Text="{Binding Who}" />
                        </StackPanel>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{StaticResource ReadingSize}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer IsVisible="{Binding IsSourceMode}" HorizontalScrollBarVisibility="Disabled">
        <TextBox x:Name="Source" Classes="bare source" Text="{Binding SourceText}" MaxWidth="760" Margin="40,32,40,40" />
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
