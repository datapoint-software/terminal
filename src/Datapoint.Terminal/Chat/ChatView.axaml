<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:agent="clr-namespace:Datapoint.Terminal.Agent;assembly=Datapoint.Terminal.Agent"
             xmlns:chat="clr-namespace:Datapoint.Terminal.Chat"
             xmlns:md="clr-namespace:Datapoint.Terminal.Markdown"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             xmlns:motion="clr-namespace:Datapoint.Terminal.Shell.Motion"
             xmlns:c="clr-namespace:Datapoint.Terminal.Components"
             x:Class="Datapoint.Terminal.Chat.ChatView"
             x:DataType="chat:ChatViewModel"
             Background="{DynamicResource PaneBrush}">
  <UserControl.Resources>
    <!-- Our own simple glyphs, 16 by 16. -->
    <StreamGeometry x:Key="CheckGlyph">M4.6,8.3 L7,10.6 L11.4,5.6</StreamGeometry>
    <StreamGeometry x:Key="CrossGlyph">M5.6,5.6 L10.4,10.4 M10.4,5.6 L5.6,10.4</StreamGeometry>
    <StreamGeometry x:Key="ChevronGlyph">M4,6 L8,10 L12,6</StreamGeometry>
    <StreamGeometry x:Key="SendGlyph">M8,1.5 L13.5,7 L12.1,8.4 L9,5.3 L9,14.5 L7,14.5 L7,5.3 L3.9,8.4 L2.5,7 Z</StreamGeometry>
    <StreamGeometry x:Key="StopGlyph">M3.5,3.5 L12.5,3.5 L12.5,12.5 L3.5,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ContinueGlyph">M4.5,2.5 L13,8 L4.5,13.5 Z</StreamGeometry>
    <StreamGeometry x:Key="GearGlyph">M6.9,1.5 L9.1,1.5 L9.4,3.2 C9.9,3.4 10.3,3.6 10.7,3.9 L12.3,3.3 L13.4,5.2 L12.1,6.3 C12.2,6.8 12.2,7.2 12.1,7.7 L13.4,8.8 L12.3,10.7 L10.7,10.1 C10.3,10.4 9.9,10.6 9.4,10.8 L9.1,12.5 L6.9,12.5 L6.6,10.8 C6.1,10.6 5.7,10.4 5.3,10.1 L3.7,10.7 L2.6,8.8 L3.9,7.7 C3.8,7.2 3.8,6.8 3.9,6.3 L2.6,5.2 L3.7,3.3 L5.3,3.9 C5.7,3.6 6.1,3.4 6.6,3.2 Z M8,5.2 C7,5.2 6.2,6 6.2,7 C6.2,8 7,8.8 8,8.8 C9,8.8 9.8,8 9.8,7 C9.8,6 9,5.2 8,5.2 Z</StreamGeometry>
    <StreamGeometry x:Key="ComposeGlyph">M2,3.5 L8.5,3.5 L8.5,5 L3.5,5 L3.5,12.5 L11,12.5 L11,7.5 L12.5,7.5 L12.5,14 L2,14 Z M12.6,1.2 L14.8,3.4 L8.6,9.6 L5.8,10.2 L6.4,7.4 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <!-- An approved plan's progress: a header that folds it, then a bar, where it's at, and each step's mark. -->
    <DataTemplate DataType="chat:PlanProgressViewModel">
      <Border Classes="group">
        <StackPanel>
          <Button Classes="row" Padding="12,9" CornerRadius="{StaticResource CardRadius}" Command="{Binding ToggleCommand}"
                  AutomationProperties.Name="{Binding HeaderText}" AutomationProperties.HelpText="{Binding ToggleHelp}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Panel Classes="mark" IsVisible="{Binding IsFolded}" Classes.running="{Binding MarkIsRunning}"
                     Classes.succeeded="{Binding MarkIsSucceeded}" Classes.failed="{Binding MarkIsFailed}">
                <c:Spinner IsVisible="{Binding MarkIsRunning}" />
                <Ellipse Classes="ring" />
                <Ellipse Classes="dot" Width="6" Height="6" />
                <Path Classes="check" Data="{StaticResource CheckGlyph}" />
                <Path Classes="cross" Data="{StaticResource CrossGlyph}" />
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding HeaderText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Path Grid.Column="2" Data="{StaticResource ChevronGlyph}" Stroke="{DynamicResource SecondaryLabelBrush}" StrokeThickness="1.5"
                    Width="16" Height="16" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Path.RenderTransform>
                  <RotateTransform Angle="{Binding ChevronAngle}" />
                </Path.RenderTransform>
              </Path>
            </Grid>
          </Button>
          <Border Padding="12,0,12,10" motion:Fold.IsOpen="{Binding IsExpanded}">
            <StackPanel Spacing="6">
              <ProgressBar Classes="plan" Minimum="0" Maximum="100" Value="{Binding Percent}" />
              <TextBlock Classes="secondary" Text="{Binding StatusText}" />
              <ItemsControl ItemsSource="{Binding Shown}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="chat:PlanStepViewModel">
                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}">
                      <Panel Classes="mark" Classes.running="{Binding IsRunning}" Classes.succeeded="{Binding IsSucceeded}" Classes.failed="{Binding IsFailed}">
                        <c:Spinner IsVisible="{Binding IsRunning}" />
                        <Ellipse Classes="ring" />
                        <Ellipse Classes="dot" Width="6" Height="6" />
                        <Path Classes="check" Data="{StaticResource CheckGlyph}" />
                        <Path Classes="cross" Data="{StaticResource CrossGlyph}" />
                      </Panel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Classes="step-title" Classes.pending="{Binding IsPending}" Classes.running="{Binding IsRunning}"
                                   Text="{Binding Title}" TextWrapping="Wrap" />
                        <!-- A step added while the plan ran, after the user approved it (product decision 125). -->
                        <TextBlock Classes="secondary" Text="{Binding ChangeText}" IsVisible="{Binding HasChange}" />
                        <TextBlock Classes="secondary" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A skill's rollout: each host's state, the health check the application runs, then Pause and Stop while it goes. -->
    <DataTemplate DataType="chat:RolloutProgressViewModel">
      <Border Classes="group">
        <StackPanel>
          <Button Classes="row" Padding="12,9" CornerRadius="{StaticResource CardRadius}" Command="{Binding ToggleCommand}"
                  AutomationProperties.Name="{Binding HeaderText}" AutomationProperties.HelpText="{Binding ToggleHelp}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="1">
                <TextBlock Classes="secondary" FontWeight="SemiBold" Text="{x:Static res:Strings.RolloutCaption}" IsVisible="{Binding IsExpanded}" />
                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Path Grid.Column="1" Data="{StaticResource ChevronGlyph}" Stroke="{DynamicResource SecondaryLabelBrush}" StrokeThickness="1.5"
                    Width="16" Height="16" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Path.RenderTransform>
                  <RotateTransform Angle="{Binding ChevronAngle}" />
                </Path.RenderTransform>
              </Path>
            </Grid>
          </Button>
          <Border Padding="12,0,12,12" motion:Fold.IsOpen="{Binding IsExpanded}">
            <StackPanel Spacing="10">
              <Border Classes="list">
                <ItemsControl ItemsSource="{Binding Hosts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="chat:RolloutHostViewModel">
                      <Border Classes="listItem" Classes.first="{Binding IsFirst}">
                        <Grid ColumnDefinitions="16,*" ColumnSpacing="10" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}">
                          <Panel Classes="mark" VerticalAlignment="Top" Margin="0,1,0,0" Classes.running="{Binding IsRunning}"
                                 Classes.succeeded="{Binding IsSucceeded}" Classes.failed="{Binding IsFailed}">
                            <c:Spinner IsVisible="{Binding IsRunning}" />
                            <Ellipse Classes="ring" />
                            <Ellipse Classes="dot" Width="6" Height="6" />
                            <Path Classes="check" Data="{StaticResource CheckGlyph}" />
                            <Path Classes="cross" Data="{StaticResource CrossGlyph}" />
                          </Panel>
                          <StackPanel Grid.Column="1" Spacing="1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Classes="step-title" Classes.pending="{Binding IsWaiting}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding StateText}" />
                            </Grid>
                            <TextBlock Classes="secondary" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                            <ProgressBar Classes="plan" Minimum="0" Maximum="100" Value="{Binding HealthPercent}" Margin="0,4,0,0"
                                         IsVisible="{Binding IsCheckingHealth}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <StackPanel Spacing="4" IsVisible="{Binding HasHealthCheck}">
                <TextBlock Classes="secondary" FontWeight="SemiBold" Text="{x:Static res:Strings.RolloutHealthCheck}" />
                <Border Classes="code">
                  <SelectableTextBlock Classes="mono" Text="{Binding HealthCheck}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
              <TextBlock Classes="secondary" Text="{x:Static res:Strings.RolloutNoHealthCheck}" TextWrapping="Wrap" IsVisible="{Binding HasNoHealthCheck}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRunning}">
                <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" />
                <Button Classes="plain danger" Content="{x:Static res:Strings.RolloutStop}" Command="{Binding StopCommand}"
                        AutomationProperties.HelpText="{x:Static res:Strings.RolloutStopHelp}" ToolTip.Tip="{x:Static res:Strings.RolloutStopHelp}" />
                <TextBlock Classes="secondary" Text="{Binding StatusText}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Border.code.highlight">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Status dot: grey when idle, accent while working, orange when it needs you, red when stopped. -->
    <Style Selector="Ellipse.status">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Fill" Value="{DynamicResource IdleBrush}" />
    </Style>
    <Style Selector="Ellipse.status.waiting">
      <Setter Property="Fill" Value="{DynamicResource WaitingBrush}" />
    </Style>
    <Style Selector="Ellipse.status.stopped">
      <Setter Property="Fill" Value="{DynamicResource StoppedBrush}" />
    </Style>

    <!-- Composer, after Claude's and Messages': one rounded field, with quiet text menus under it. -->
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox.menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="FontSize" Value="{StaticResource SmallSize}" />
      <Setter Property="Padding" Value="10,2,0,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="ComboBox.menu /template/ Border#Background">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.menu:pointerover /template/ Border#Background, ComboBox.menu:pressed /template/ Border#Background, ComboBox.menu:dropdownopen /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.menu:pointerover /template/ ContentControl#ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="ComboBox.menu /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Conversation: your messages in accent bubbles, the agent's as plain text, commands as code cards. -->
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="MaxWidth" Value="290" />
      <Setter Property="Margin" Value="40,6,0,6" />
    </Style>
    <Style Selector="Border.bubble SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.choice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    </Style>
    <Style Selector="Button.choice.recommended /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
    <Style Selector="Button.choice.other TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.key TextBlock">
      <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.choice.recommended Border.key">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.choice.recommended Border.key TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Plans. A step's mark: an empty ring before it runs, a ring and dot while it runs, a tick or a cross after. -->
    <Style Selector="Panel.mark">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Panel.mark Ellipse.ring">
      <Setter Property="Stroke" Value="{DynamicResource IdleBrush}" />
      <Setter Property="StrokeThickness" Value="1.25" />
    </Style>
    <Style Selector="Panel.mark Ellipse.dot, Panel.mark Path">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.mark Path">
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- The step being worked on turns, as everything in progress does (product decision 122). -->
    <Style Selector="Panel.mark.running Ellipse.ring">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.mark.succeeded Ellipse.ring">
      <Setter Property="Stroke" Value="{DynamicResource SyntaxAddedBrush}" />
    </Style>
    <Style Selector="Panel.mark.succeeded Path.check">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Stroke" Value="{DynamicResource SyntaxAddedBrush}" />
    </Style>
    <Style Selector="Panel.mark.failed Ellipse.ring">
      <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Panel.mark.failed Path.cross">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
    </Style>
    <!-- A host on the Looking card: a hairline between hosts, none above the first. -->
    <Style Selector="Border.lookHost">
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border.lookHost.first">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.step-title.pending">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="TextBlock.step-title.running">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ProgressBar.plan">
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
    </Style>

  </UserControl.Styles>

  <DockPanel>
    <!-- Header: the agent and the model it talks to, which is chosen in settings (product decision 123). What the agent is
         doing sits above the message box, where the user looks while waiting. -->
    <!-- Dragging the header moves the chat elsewhere in the window (product decision 109). -->
    <Border x:Name="Header" DockPanel.Dock="Top" Height="{StaticResource PaneHeaderHeight}" Padding="16,0,10,0" Background="Transparent" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="title" Text="{x:Static res:Strings.ChatTitle}" />
          <!-- One line, so the header keeps the sidebar's height. -->
          <TextBlock x:Name="ModelName" Classes="secondary" Text="{Binding ModelName}" IsVisible="{Binding HasModelName}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModelName}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="icon" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}"
                  ToolTip.Tip="{x:Static res:Strings.ChatStop}" AutomationProperties.Name="{x:Static res:Strings.ChatStop}">
            <PathIcon Data="{StaticResource StopGlyph}" />
          </Button>
          <Button Classes="icon" Command="{Binding ContinueCommand}" IsVisible="{Binding IsInterrupted}"
                  ToolTip.Tip="{x:Static res:Strings.ChatContinue}" AutomationProperties.Name="{x:Static res:Strings.ChatContinue}">
            <PathIcon Data="{StaticResource ContinueGlyph}" />
          </Button>
          <Button Classes="icon" Command="{Binding ClearCommand}"
                  ToolTip.Tip="{x:Static res:Strings.ChatClear}" AutomationProperties.Name="{x:Static res:Strings.ChatClear}">
            <PathIcon Data="{StaticResource ComposeGlyph}" />
          </Button>
          <Button Classes="icon" Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="{x:Static res:Strings.ChatSettings}" AutomationProperties.Name="{x:Static res:Strings.ChatSettings}">
            <PathIcon Data="{StaticResource GearGlyph}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Bottom: approvals and questions, then the composer and the approval mode. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12" MaxWidth="{StaticResource ReadingWidth}">
      <!-- No provider yet: offer to connect one. -->
      <Border Classes="card" IsVisible="{Binding NeedsProvider}">
        <StackPanel Spacing="10">
          <TextBlock Classes="title" Text="{x:Static res:Strings.ChatConnect}" />
          <TextBlock Text="{x:Static res:Strings.ChatConnectText}" TextWrapping="Wrap" />
          <Button Classes="primary" HorizontalAlignment="Right" Content="{x:Static res:Strings.SettingsAdd}" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
      </Border>

      <!-- The agent waiting for the user to type in a terminal (product decision 115). The button takes them there, expanding
           the terminals if they're collapsed; the card never takes the focus itself. -->
      <Border Classes="card" IsVisible="{Binding HasInputTerminal}"
              AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding InputTerminalTitle}">
        <StackPanel Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="{Binding InputTerminalTitle}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.ChatTerminalInputText}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Classes="primary" HorizontalAlignment="Right" Content="{Binding InputTerminalShow}" Command="{Binding ShowInputTerminalCommand}" />
        </StackPanel>
      </Border>

      <!-- A command waiting for approval. It never takes focus from the terminal; Run needs a click, or Tab and Space. -->
      <Border Classes="card" IsVisible="{Binding Approval, Converter={x:Static ObjectConverters.IsNotNull}}"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{x:Static res:Strings.StatusWaitingForApproval}">
        <StackPanel Spacing="8" DataContext="{Binding Approval}" x:DataType="chat:ApprovalViewModel">
          <StackPanel Spacing="2">
            <TextBlock Classes="secondary" FontWeight="SemiBold" Text="{Binding TerminalText}" TextWrapping="Wrap" IsVisible="{Binding !UsesOwnActions}" />
            <TextBlock Classes="title" Text="{Binding Heading}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" IsVisible="{Binding ShowsPurpose}" />
          </StackPanel>
          <!-- A request to look: each host, and what the agent will look for there and why, then what allowing it permits. -->
          <StackPanel Spacing="10" IsVisible="{Binding IsLook}">
            <ItemsControl ItemsSource="{Binding LookHosts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="chat:LookHostViewModel">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <ContentControl Content="{Binding Chip}" ContentTemplate="{StaticResource HostChip}" />
                      <TextBlock Classes="secondary" Text="{x:Static res:Strings.ApprovalLookOpens}" IsVisible="{Binding OpensConnection}"
                                 VerticalAlignment="Top" Margin="0,3,0,0" />
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="{DynamicResource PaneBrush}" CornerRadius="{StaticResource BlockRadius}" Padding="10,8">
              <TextBlock Classes="secondary" FontSize="{StaticResource SmallSize}" Text="{Binding LookScopeText}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
          <!-- A plan (product decision 117): only that it's ready, since it opens in the documents area, where it's read,
               commented on and approved. -->
          <TextBlock Text="{Binding PlanReadyText}" TextWrapping="Wrap" IsVisible="{Binding IsPlan}" />
          <!-- Capped, so a long diff scrolls inside the box and Run and Decline stay in view. -->
          <TextBox x:Name="ApprovalCommand" Classes="code" Text="{Binding Command}" IsReadOnly="{Binding IsCommandReadOnly}" TextWrapping="Wrap" Background="{DynamicResource CodeBrush}"
                   MaxHeight="280" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.ApprovalCommandLabel}" />
          <TextBlock Text="{Binding PlanText}" IsVisible="{Binding HasPlanText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="secondary" Text="{Binding RiskText}" TextWrapping="Wrap" IsVisible="{Binding !UsesOwnActions}" />
          <TextBlock Classes="secondary" Text="{Binding AlsoApprovesText}" IsVisible="{Binding HasAlsoApproves}" TextWrapping="Wrap" />
          <!-- Teaching a command as read-only lets it run without asking from now on, so it's a choice made with this approval. -->
          <CheckBox IsChecked="{Binding TreatAsReadOnly}" IsVisible="{Binding HasReadOnlySuggestion}"
                    AutomationProperties.Name="{Binding ReadOnlyOfferText}" ToolTip.Tip="{x:Static res:Strings.ApprovalTreatAsReadOnlyHint}">
            <TextBlock Text="{Binding ReadOnlyOfferText}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBox x:Name="ApprovalFeedback" Text="{Binding Feedback}" PlaceholderText="{x:Static res:Strings.ApprovalFeedbackPlaceholder}" TextWrapping="Wrap"
                   AutomationProperties.Name="{x:Static res:Strings.ApprovalFeedbackPlaceholder}" IsVisible="{Binding ShowsFeedback}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding !UsesOwnActions}">
            <Button Content="{Binding DeclineLabel}" Command="{Binding DeclineCommand}" />
            <Button Classes="primary" Content="{Binding RunLabel}" Command="{Binding RunCommand}" />
          </StackPanel>
          <!-- A look or a plan: the main choice first, as the conversation reads, and a reply in the user's words on request. -->
          <WrapPanel IsVisible="{Binding IsLook}">
            <Button Classes="primary" Margin="0,0,8,0" Content="{Binding RunLabel}" Command="{Binding RunCommand}" />
            <Button Margin="0,0,8,0" Content="{Binding DeclineLabel}" Command="{Binding DeclineCommand}" IsVisible="{Binding !IsReplying}" />
            <Button Margin="0,0,8,0" Content="{x:Static res:Strings.ApprovalSendReply}" Command="{Binding DeclineCommand}" IsVisible="{Binding IsReplying}" />
            <Button Classes="plain" Content="{x:Static res:Strings.ApprovalReply}" Command="{Binding ReplyCommand}" IsVisible="{Binding !IsReplying}" />
          </WrapPanel>
          <WrapPanel IsVisible="{Binding IsPlan}">
            <Button Content="{x:Static res:Strings.PlanShow}" Command="{Binding ReviewCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- A question from the agent: one list to click, or pick from by number while the card has focus. Like an approval,
           it never takes focus from the terminal. -->
      <Border x:Name="QuestionCard" Classes="card" IsVisible="{Binding Question, Converter={x:Static ObjectConverters.IsNotNull}}"
              AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{x:Static res:Strings.StatusWaitingForUser}">
        <StackPanel Spacing="8" DataContext="{Binding Question}" x:DataType="chat:QuestionViewModel">
          <!-- Capped, so long background scrolls and the choices stay in view. Only the question itself is bold. -->
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
              <TextBlock Classes="secondary" FontWeight="SemiBold" Text="{Binding HeaderText}" TextWrapping="Wrap" />
              <md:MarkdownView Text="{Binding Details}" IsVisible="{Binding HasDetails}" />
              <SelectableTextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <Border Classes="list" IsVisible="{Binding IsChoosing}">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,-1,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="chat:QuestionRowViewModel">
                  <Button Classes="choice" Classes.recommended="{Binding IsRecommended}" Classes.other="{Binding IsOther}"
                          Command="{Binding $parent[ItemsControl].((chat:QuestionViewModel)DataContext).ChooseCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}"
                          AutomationProperties.AcceleratorKey="{Binding NumberText}">
                    <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
                      <Border Classes="key">
                        <TextBlock Text="{Binding NumberText}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <c:Badge Grid.Column="1" Classes="accent" Text="{x:Static res:Strings.QuestionRecommended}" IsVisible="{Binding IsRecommended}"
                                   Margin="8,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsChoosing}">
            <TextBlock Classes="secondary" Text="{Binding KeysText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="plain" Content="{x:Static res:Strings.QuestionSkip}" Command="{Binding SkipCommand}" />
          </Grid>
          <!-- An answer in the user's own words: in place of the list after "Something else…", or straight away when there are no
               choices. -->
          <StackPanel x:Name="QuestionWriting" Spacing="8" IsVisible="{Binding IsWriting}">
            <TextBox x:Name="QuestionAnswerBox" Text="{Binding Draft}" PlaceholderText="{x:Static res:Strings.QuestionPlaceholder}" TextWrapping="Wrap"
                     AutomationProperties.Name="{x:Static res:Strings.QuestionPlaceholder}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{x:Static res:Strings.QuestionBack}" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
              <Button Content="{x:Static res:Strings.QuestionSkip}" Command="{Binding SkipCommand}" IsVisible="{Binding !CanGoBack}" />
              <Button Classes="primary" Content="{x:Static res:Strings.QuestionSend}" Command="{Binding SubmitCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="secondary" Text="{Binding PendingOutputText}" IsVisible="{Binding HasPendingOutput}" TextWrapping="Wrap"
                 Margin="4,0,4,6" />

      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasExcerpt}" Margin="4,0,0,6">
        <TextBlock Classes="secondary" Text="{Binding ExcerptText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="plain" Content="{x:Static res:Strings.ExcerptRemove}" Command="{Binding RemoveExcerptCommand}"
                AutomationProperties.Name="{x:Static res:Strings.ExcerptRemove}" />
      </Grid>

      <!-- What the agent is doing, right above where the user writes to it: a spinner while it works, a dot while it waits,
           is idle or stopped. Announced to screen readers as it changes. -->
      <StackPanel x:Name="ComposerStatus" Orientation="Horizontal" Spacing="6" Margin="4,0,8,6">
        <Panel Width="12" Height="12" VerticalAlignment="Center">
          <c:Spinner IsVisible="{Binding IsWorking}" />
          <Ellipse Classes="status" Classes.waiting="{Binding NeedsUser}" Classes.stopped="{Binding IsInterrupted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsWorking}" />
        </Panel>
        <TextBlock Classes="secondary" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <!-- Composer: a rounded field with the send button inside, and a quiet menu for approval under it. -->
      <Border Classes="composer">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="DraftBox" Classes="bare" Padding="12,10,6,10" MinHeight="38" Text="{Binding Draft}" PlaceholderText="{Binding DraftPlaceholder}"
                   TextWrapping="Wrap" MaxHeight="160" VerticalContentAlignment="Center" IsEnabled="{Binding HasAgent}"
                   AutomationProperties.Name="{x:Static res:Strings.ChatInputPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Classes="primary" Command="{Binding SendCommand}" Width="26" Height="26" MinHeight="0" Padding="6"
                  CornerRadius="13" VerticalAlignment="Bottom" Margin="0,0,6,6"
                  ToolTip.Tip="{x:Static res:Strings.ChatSend}" AutomationProperties.Name="{x:Static res:Strings.ChatSend}">
            <PathIcon Data="{StaticResource SendGlyph}" Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto" Margin="0,6,-4,0">
      <!-- How much of the model's context the conversation fills, as a ring and in tokens; what the session has used and cost
           opens from it (product decisions 49 and 126). -->
      <Button x:Name="ContextUse" Classes="plain" Margin="0,0,8,0" Padding="4,2"
              VerticalAlignment="Center" HorizontalAlignment="Left" IsVisible="{Binding HasContext}"
              ToolTip.Tip="{x:Static res:Strings.ContextUseHelp}" AutomationProperties.Name="{Binding ContextDetail}"
              AutomationProperties.HelpText="{x:Static res:Strings.ContextUseHelp}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Panel Width="12" Height="12" VerticalAlignment="Center">
            <Ellipse Stroke="{DynamicResource SeparatorBrush}" StrokeThickness="1.5" />
            <Arc StartAngle="-90" SweepAngle="{Binding ContextSweep}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
          </Panel>
          <TextBlock Classes="secondary" Text="{Binding ContextText}" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedLeft">
            <StackPanel x:Name="UsageDetails" Spacing="6" MaxWidth="320" Margin="4">
              <TextBlock Text="{Binding ContextDetail}" TextWrapping="Wrap" />
              <SelectableTextBlock Classes="secondary" Text="{Binding UsageSummary}" IsVisible="{Binding HasUsage}" TextWrapping="Wrap" />
              <SelectableTextBlock Classes="secondary" Text="{Binding UsageDetail}" IsVisible="{Binding HasUsageDetail}" TextWrapping="Wrap" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
        <ComboBox Classes="menu" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                  ToolTip.Tip="{Binding SelectedMode.Help}" AutomationProperties.Name="{x:Static res:Strings.ChatMode}">
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="chat:ModeOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="chat:ModeOption">
              <StackPanel MaxWidth="240" Margin="0,2">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Classes="secondary" Text="{Binding Help}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      </Grid>
    </StackPanel>

    <!-- The plan in progress, pinned so it stays in view while the conversation scrolls. -->
    <ContentControl DockPanel.Dock="Top" Content="{Binding ActivePlan}" motion:Fold.IsOpen="{Binding HasActivePlan}" Padding="12,8,12,4" MaxWidth="{StaticResource ReadingWidth}" />
    <ContentControl DockPanel.Dock="Top" Content="{Binding ActiveRollout}" motion:Fold.IsOpen="{Binding HasActiveRollout}" Padding="12,8,12,4" MaxWidth="{StaticResource ReadingWidth}" />

    <!-- The conversation, a centred reading column however wide the window is; the scroll bar stays at the pane's edge. -->
    <ScrollViewer x:Name="Scroller" Padding="16,8">
      <StackPanel MaxWidth="{StaticResource ReadingWidth}">
      <ItemsControl x:Name="ItemList" ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="chat:ChatItemViewModel">
            <Panel>
              <Border Classes="bubble" IsVisible="{Binding IsUser}">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
              <md:MarkdownView Text="{Binding Text}" Margin="0,6" IsVisible="{Binding IsAgent}" />
              <Border Classes="code" Classes.highlight="{Binding IsHighlighted}" IsVisible="{Binding IsCommand}">
                <StackPanel Spacing="4">
                  <SelectableTextBlock Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Classes="secondary" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <!-- An approved plan, once its task is over; while it runs, it's pinned above the conversation. -->
              <ContentControl Content="{Binding Plan}" Margin="0,6" IsVisible="{Binding Plan.IsInConversation, FallbackValue=False}" />
              <ContentControl Content="{Binding Rollout}" Margin="0,6" IsVisible="{Binding Rollout.IsInConversation, FallbackValue=False}" />
              <!-- What the agent ran on each host while looking, a line per command, marked as each finishes. -->
              <Border Classes="card" Margin="0,6" IsVisible="{Binding IsLook}">
                <StackPanel Spacing="8" DataContext="{Binding Look}" x:DataType="chat:LookProgressViewModel">
                  <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Hosts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="chat:LookProgressHostViewModel">
                        <Border Classes="lookHost" Classes.first="{Binding IsFirst}">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,-4">
                              <ContentControl Content="{Binding Chip}" ContentTemplate="{StaticResource HostChip}" />
                              <TextBlock Classes="secondary" FontSize="{StaticResource SmallSize}" Text="{Binding State}" VerticalAlignment="Center"
                                         IsVisible="{Binding State, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Commands}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="chat:LookCommandViewModel">
                                  <Grid ColumnDefinitions="14,*" ColumnSpacing="4" Margin="0,1">
                                    <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                                      <TextBlock Text="✓" Foreground="{DynamicResource SyntaxAddedBrush}" FontSize="{StaticResource SmallSize}" IsVisible="{Binding IsDone}" />
                                      <c:Spinner IsVisible="{Binding IsRunning}" Margin="0,2,0,0" HorizontalAlignment="Left" />
                                      <TextBlock Text="✗" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource SmallSize}" IsVisible="{Binding IsFailed}" />
                                    </Panel>
                                    <SelectableTextBlock Grid.Column="1" Classes="mono secondary" Text="{Binding Command}" TextWrapping="Wrap" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <!-- A question the agent asked, kept quiet once answered; the answer follows as the user's message. -->
              <SelectableTextBlock Classes="secondary" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding IsAsked}" />
              <!-- A web search or page read: what it was, then the pages, which ask before opening. -->
              <StackPanel Margin="0,6" Spacing="2" IsVisible="{Binding IsWeb}">
                <SelectableTextBlock Classes="secondary" FontWeight="SemiBold" Text="{Binding Text}" TextWrapping="Wrap" />
                <Border Classes="warning" IsVisible="{Binding HasWarning}">
                  <TextBlock Text="{Binding Warning, StringFormat=⚠ {0}}" TextWrapping="Wrap" />
                </Border>
                <md:MarkdownView Text="{Binding Detail}" />
              </StackPanel>
              <StackPanel Margin="12,6" Spacing="4" IsVisible="{Binding IsNotice}">
                <SelectableTextBlock Classes="secondary" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding HasAction}"
                        HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
