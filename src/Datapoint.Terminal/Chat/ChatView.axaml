<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:agent="clr-namespace:Datapoint.Terminal.Agent;assembly=Datapoint.Terminal.Agent"
             xmlns:chat="clr-namespace:Datapoint.Terminal.Chat"
             xmlns:md="clr-namespace:Datapoint.Terminal.Markdown"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             x:Class="Datapoint.Terminal.Chat.ChatView"
             x:DataType="chat:ChatViewModel"
             Background="{DynamicResource PaneBrush}">
  <UserControl.Resources>
    <!-- Our own simple glyphs, 16 by 16. -->
    <StreamGeometry x:Key="SendGlyph">M8,1.5 L13.5,7 L12.1,8.4 L9,5.3 L9,14.5 L7,14.5 L7,5.3 L3.9,8.4 L2.5,7 Z</StreamGeometry>
    <StreamGeometry x:Key="StopGlyph">M3.5,3.5 L12.5,3.5 L12.5,12.5 L3.5,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ContinueGlyph">M4.5,2.5 L13,8 L4.5,13.5 Z</StreamGeometry>
    <StreamGeometry x:Key="GearGlyph">M6.9,1.5 L9.1,1.5 L9.4,3.2 C9.9,3.4 10.3,3.6 10.7,3.9 L12.3,3.3 L13.4,5.2 L12.1,6.3 C12.2,6.8 12.2,7.2 12.1,7.7 L13.4,8.8 L12.3,10.7 L10.7,10.1 C10.3,10.4 9.9,10.6 9.4,10.8 L9.1,12.5 L6.9,12.5 L6.6,10.8 C6.1,10.6 5.7,10.4 5.3,10.1 L3.7,10.7 L2.6,8.8 L3.9,7.7 C3.8,7.2 3.8,6.8 3.9,6.3 L2.6,5.2 L3.7,3.3 L5.3,3.9 C5.7,3.6 6.1,3.4 6.6,3.2 Z M8,5.2 C7,5.2 6.2,6 6.2,7 C6.2,8 7,8.8 8,8.8 C9,8.8 9.8,8 9.8,7 C9.8,6 9,5.2 8,5.2 Z</StreamGeometry>
    <StreamGeometry x:Key="ComposeGlyph">M2,3.5 L8.5,3.5 L8.5,5 L3.5,5 L3.5,12.5 L11,12.5 L11,7.5 L12.5,7.5 L12.5,14 L2,14 Z M12.6,1.2 L14.8,3.4 L8.6,9.6 L5.8,10.2 L6.4,7.4 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.code.highlight">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.secondary, SelectableTextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    </Style>

    <!-- Status dot: grey when idle, accent while working, orange when it needs you, red when stopped. -->
    <Style Selector="Ellipse.status">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Fill" Value="{DynamicResource IdleBrush}" />
    </Style>
    <Style Selector="Ellipse.status.working">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Ellipse.status.waiting">
      <Setter Property="Fill" Value="{DynamicResource WaitingBrush}" />
    </Style>
    <Style Selector="Ellipse.status.stopped">
      <Setter Property="Fill" Value="{DynamicResource StoppedBrush}" />
    </Style>

    <!-- Composer, after Claude's and Messages': one rounded field, with quiet text menus under it. -->
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,10,6,10" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement, TextBox.bare:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,2,0,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox.menu /template/ Border#Background">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.menu:pointerover /template/ Border#Background, ComboBox.menu:pressed /template/ Border#Background, ComboBox.menu:dropdownopen /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.menu:pointerover /template/ ContentControl#ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="ComboBox.menu /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Conversation: your messages in accent bubbles, the agent's as plain text, commands as code cards. -->
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="MaxWidth" Value="290" />
      <Setter Property="Margin" Value="40,6,0,6" />
    </Style>
    <Style Selector="Border.bubble SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- A choice offered by the agent: label, a line on what it does, and a tag on the one it recommends. -->
    <Style Selector="Button.option">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.option.recommended /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Plans: a warning glyph in the waiting colour beside text in the label colour, so the warning keeps its contrast. -->
    <Style Selector="TextBlock.warning-glyph">
      <Setter Property="Foreground" Value="{DynamicResource WaitingBrush}" />
    </Style>
    <Style Selector="Border.plan">
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TextBlock.step">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="TextBlock.step.running">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.step.succeeded">
      <Setter Property="Foreground" Value="{DynamicResource SyntaxAddedBrush}" />
    </Style>
    <Style Selector="TextBlock.step.failed">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header: what the agent is doing, announced to screen readers as it changes. -->
    <Border DockPanel.Dock="Top" Padding="16,12,10,10" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="{x:Static res:Strings.ChatTitle}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="status" Classes.working="{Binding IsWorking}" Classes.waiting="{Binding NeedsUser}"
                     Classes.stopped="{Binding IsInterrupted}" VerticalAlignment="Center" />
            <TextBlock Classes="secondary" Text="{Binding StatusText}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="icon" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}"
                  ToolTip.Tip="{x:Static res:Strings.ChatStop}" AutomationProperties.Name="{x:Static res:Strings.ChatStop}">
            <PathIcon Data="{StaticResource StopGlyph}" />
          </Button>
          <Button Classes="icon" Command="{Binding ContinueCommand}" IsVisible="{Binding IsInterrupted}"
                  ToolTip.Tip="{x:Static res:Strings.ChatContinue}" AutomationProperties.Name="{x:Static res:Strings.ChatContinue}">
            <PathIcon Data="{StaticResource ContinueGlyph}" />
          </Button>
          <Button Classes="icon" Command="{Binding ClearCommand}"
                  ToolTip.Tip="{x:Static res:Strings.ChatClear}" AutomationProperties.Name="{x:Static res:Strings.ChatClear}">
            <PathIcon Data="{StaticResource ComposeGlyph}" />
          </Button>
          <Button Classes="icon" Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="{x:Static res:Strings.ChatSettings}" AutomationProperties.Name="{x:Static res:Strings.ChatSettings}">
            <PathIcon Data="{StaticResource GearGlyph}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Bottom: approvals and questions, then the composer and the approval mode. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
      <!-- No provider yet: offer to connect one. -->
      <Border Classes="card" IsVisible="{Binding NeedsProvider}">
        <StackPanel Spacing="10">
          <TextBlock Classes="title" Text="{x:Static res:Strings.ChatConnect}" />
          <TextBlock Text="{x:Static res:Strings.ChatConnectText}" TextWrapping="Wrap" />
          <Button Classes="primary" HorizontalAlignment="Right" Content="{x:Static res:Strings.SettingsAdd}" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
      </Border>

      <!-- A command waiting for approval. It never takes focus from the terminal; Run needs a click, or Tab and Space. -->
      <Border Classes="card" IsVisible="{Binding Approval, Converter={x:Static ObjectConverters.IsNotNull}}"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{x:Static res:Strings.StatusWaitingForApproval}">
        <StackPanel Spacing="8" DataContext="{Binding Approval}" x:DataType="chat:ApprovalViewModel">
          <StackPanel Spacing="2">
            <TextBlock Classes="secondary" FontWeight="SemiBold" Text="{Binding TerminalText}" TextWrapping="Wrap" />
            <TextBlock Classes="title" Text="{Binding Heading}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" />
          </StackPanel>
          <!-- A plan: each step says what it does, flags anything risky, then shows the exact command. Capped, so a long plan
               scrolls inside the box while the rollback, Approve and Decline stay in view. -->
          <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsPlan}">
            <ItemsControl ItemsSource="{Binding PlanSteps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="chat:PlanStepViewModel">
                  <Grid ColumnDefinitions="22,*" Margin="0,0,8,0">
                    <TextBlock Classes="secondary" Text="{Binding NumberText}" FontWeight="SemiBold" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" IsVisible="{Binding HasPurpose}" />
                      <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Classes="warning-glyph" Text="⚠" />
                              <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="code">
                        <SelectableTextBlock Classes="mono" Text="{Binding Command}" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Spacing="2" IsVisible="{Binding HasRollback}">
            <TextBlock Text="{x:Static res:Strings.PlanRollbackTitle}" FontWeight="SemiBold" />
            <md:MarkdownView Text="{Binding Rollback}" />
          </StackPanel>
          <!-- Capped, so a long diff scrolls inside the box and Run and Decline stay in view. -->
          <TextBox x:Name="ApprovalCommand" Classes="code" Text="{Binding Command}" IsReadOnly="{Binding IsCommandReadOnly}" TextWrapping="Wrap" Background="{DynamicResource CodeBrush}"
                   MaxHeight="280" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.ApprovalCommandLabel}" />
          <TextBlock Text="{Binding PlanText}" IsVisible="{Binding HasPlanText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="secondary" Text="{Binding RiskText}" TextWrapping="Wrap" />
          <TextBlock Classes="secondary" Text="{Binding AlsoApprovesText}" IsVisible="{Binding HasAlsoApproves}" TextWrapping="Wrap" />
          <TextBox Text="{Binding Feedback}" PlaceholderText="{x:Static res:Strings.ApprovalFeedbackPlaceholder}" TextWrapping="Wrap"
                   AutomationProperties.Name="{x:Static res:Strings.ApprovalFeedbackPlaceholder}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.ApprovalDecline}" Command="{Binding DeclineCommand}" />
            <Button Classes="primary" Content="{Binding RunLabel}" Command="{Binding RunCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- A question from the agent. -->
      <Border Classes="card" IsVisible="{Binding Question, Converter={x:Static ObjectConverters.IsNotNull}}"
              AutomationProperties.LiveSetting="Assertive">
        <StackPanel Spacing="8" DataContext="{Binding Question}" x:DataType="chat:QuestionViewModel">
          <!-- Capped, so long background scrolls and the choices stay in view. Only the question itself is bold. -->
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
              <md:MarkdownView Text="{Binding Details}" IsVisible="{Binding HasDetails}" />
              <SelectableTextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="agent:AgentOption">
                <Button Classes="option" Classes.recommended="{Binding IsRecommended}"
                        Command="{Binding $parent[ItemsControl].((chat:QuestionViewModel)DataContext).ChooseCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="tag" IsVisible="{Binding IsRecommended}" Margin="8,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{x:Static res:Strings.QuestionRecommended}" />
                      </Border>
                    </Grid>
                    <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox Text="{Binding Draft}" PlaceholderText="{x:Static res:Strings.QuestionPlaceholder}"
                   AutomationProperties.Name="{x:Static res:Strings.QuestionPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.QuestionSkip}" Command="{Binding SkipCommand}" />
            <Button Classes="primary" Content="{x:Static res:Strings.QuestionAnswer}" Command="{Binding SubmitCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="secondary" Text="{Binding PendingOutputText}" IsVisible="{Binding HasPendingOutput}" TextWrapping="Wrap"
                 Margin="4,0,4,6" />

      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasExcerpt}" Margin="4,0,0,6">
        <TextBlock Classes="secondary" Text="{Binding ExcerptText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="plain" Content="{x:Static res:Strings.ExcerptRemove}" Command="{Binding RemoveExcerptCommand}"
                AutomationProperties.Name="{x:Static res:Strings.ExcerptRemove}" />
      </Grid>

      <!-- Composer: a rounded field with the send button inside, and quiet menus for the model and approval under it. -->
      <Border Classes="composer">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="DraftBox" Classes="bare" Text="{Binding Draft}" PlaceholderText="{x:Static res:Strings.ChatInputPlaceholder}"
                   TextWrapping="Wrap" MaxHeight="160" VerticalContentAlignment="Center" IsEnabled="{Binding HasAgent}"
                   AutomationProperties.Name="{x:Static res:Strings.ChatInputPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Classes="primary" Command="{Binding SendCommand}" Width="26" Height="26" MinHeight="0" Padding="6"
                  CornerRadius="13" VerticalAlignment="Bottom" Margin="0,0,6,6"
                  ToolTip.Tip="{x:Static res:Strings.ChatSend}" AutomationProperties.Name="{x:Static res:Strings.ChatSend}">
            <PathIcon Data="{StaticResource SendGlyph}" Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto" Margin="0,6,-4,0">
      <TextBlock Classes="secondary" Text="{Binding UsageSummary}" IsVisible="{Binding HasUsage}" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Margin="4,0,8,0" ToolTip.Tip="{Binding UsageDetail}" Focusable="True"
                 AutomationProperties.Name="{Binding UsageSummary}" AutomationProperties.HelpText="{Binding UsageDetail}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
        <ComboBox Classes="menu" ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel}"
                  IsVisible="{Binding HasModelChoices}" ToolTip.Tip="{x:Static res:Strings.ChatModel}"
                  AutomationProperties.Name="{x:Static res:Strings.ChatModel}">
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="chat:ModelChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="chat:ModelChoice">
              <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Classes="secondary" FontSize="11" Text="{Binding Provider}" IsVisible="{Binding HasProvider}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Classes="menu" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                  ToolTip.Tip="{Binding SelectedMode.Help}" AutomationProperties.Name="{x:Static res:Strings.ChatMode}">
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="chat:ModeOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="chat:ModeOption">
              <StackPanel MaxWidth="240" Margin="0,2">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Classes="secondary" FontSize="11" Text="{Binding Help}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      </Grid>
    </StackPanel>

    <!-- The conversation. -->
    <ScrollViewer x:Name="Scroller" Padding="16,8">
      <ItemsControl x:Name="ItemList" ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="chat:ChatItemViewModel">
            <Panel>
              <Border Classes="bubble" IsVisible="{Binding IsUser}">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
              <md:MarkdownView Text="{Binding Text}" Margin="0,6" IsVisible="{Binding IsAgent}" />
              <Border Classes="code" Classes.highlight="{Binding IsHighlighted}" IsVisible="{Binding IsCommand}">
                <StackPanel Spacing="4">
                  <SelectableTextBlock Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Classes="secondary" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <!-- An approved plan, ticked off as the agent carries out each step. -->
              <Border Classes="plan" IsVisible="{Binding IsPlan}">
                <StackPanel Spacing="6">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.PlanChecklistTitle}" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="chat:PlanStepViewModel">
                        <Grid ColumnDefinitions="20,*" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}">
                          <TextBlock Classes="step" Classes.running="{Binding IsRunning}" Classes.succeeded="{Binding IsSucceeded}"
                                     Classes.failed="{Binding IsFailed}" Text="{Binding Glyph}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock TextWrapping="Wrap">
                              <Run Text="{Binding NumberText}" /><Run Text=". " /><Run Text="{Binding Title}" />
                            </TextBlock>
                            <TextBlock Classes="secondary" FontFamily="{StaticResource MonoFont}" Text="{Binding Command}"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Command}" IsVisible="{Binding HasPurpose}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <StackPanel Margin="12,6" Spacing="4" IsVisible="{Binding IsNotice}">
                <SelectableTextBlock Classes="secondary" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding HasAction}"
                        HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
