<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="clr-namespace:Datapoint.Terminal.Chat"
        xmlns:side="clr-namespace:Datapoint.Terminal.Sidebar"
        xmlns:shell="clr-namespace:Datapoint.Terminal.Shell"
        xmlns:ed="clr-namespace:Datapoint.Terminal.Editor"
        xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
        xmlns:c="clr-namespace:Datapoint.Terminal.Components"
        xmlns:controls="clr-namespace:Datapoint.Terminal.Controls;assembly=Datapoint.Terminal.Controls"
        x:Class="Datapoint.Terminal.Shell.MainWindow"
        x:DataType="shell:MainWindow"
        Width="1300" Height="760" MinWidth="640" MinHeight="400">
  <Window.Resources>
    <StreamGeometry x:Key="PlusGlyph">M7.25,2 L8.75,2 L8.75,7.25 L14,7.25 L14,8.75 L8.75,8.75 L8.75,14 L7.25,14 L7.25,8.75 L2,8.75 L2,7.25 L7.25,7.25 Z</StreamGeometry>
    <StreamGeometry x:Key="DocumentTabGlyph">M3.75,1.75 L9.5,1.75 L12.25,4.5 L12.25,14.25 L3.75,14.25 Z M9.5,1.75 L9.5,4.5 L12.25,4.5</StreamGeometry>
    <StreamGeometry x:Key="CloseGlyph">M4.1,3 L8,6.9 L11.9,3 L13,4.1 L9.1,8 L13,11.9 L11.9,13 L8,9.1 L4.1,13 L3,11.9 L6.9,8 L3,4.1 Z</StreamGeometry>
  </Window.Resources>
  <Window.Styles>
    <!-- Tabs: a ListBox, so arrow keys move between tabs and screen readers announce them as a list. -->
    <Style Selector="ListBox.tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="2" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
      <Setter Property="Padding" Value="10,0,4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="{StaticResource RowHeight}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="FontSize" Value="{StaticResource SmallSize}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox#Tabs ListBoxItem" x:DataType="shell:TerminalTab">
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
    </Style>
    <Style Selector="ListBox#DocumentTabs ListBoxItem" x:DataType="ed:IOpenDocument">
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    </Style>
    <!-- While a document is in front, the terminal tab behind it isn't shown as selected. -->
    <Style Selector="ListBox.tabs.behind ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="ListBox.tabs.behind ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    </Style>
    <Style Selector="Button.tabclose">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.tabclose, ListBoxItem:selected Button.tabclose, Button.tabclose:focus">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tabclose PathIcon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="controls|TerminalView">
      <Setter Property="AgentMarkBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="UserMarkBrush" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <NativeMenuBar />
    <!-- The sidebar on the left (product decision 98), then the terminals and the chat. -->
    <Grid x:Name="WorkArea" Grid.Row="1" ColumnDefinitions="240,1,*">
    <side:SidebarView x:Name="Sidebar" AutomationProperties.AutomationId="Sidebar" />
    <Rectangle x:Name="SidebarSeparator" Grid.Column="1" Fill="{DynamicResource SeparatorBrush}" />
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" ResizeDirection="Columns" Margin="-3,0" ZIndex="1" />
    <!-- The chat fills the window; the terminals dock beside it, their side and size set in code (MainWindow.Layout.cs). -->
    <Grid x:Name="Body" Grid.Column="2" ColumnDefinitions="*,1,380">
    <DockPanel x:Name="TerminalArea">
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button x:Name="NewTabButton" DockPanel.Dock="Right" Classes="icon" Margin="0,0,6,0" VerticalAlignment="Center" Click="OnNewTabClicked"
                  ToolTip.Tip="{x:Static res:Strings.TabNew}" AutomationProperties.Name="{x:Static res:Strings.TabNew}">
            <PathIcon Data="{StaticResource PlusGlyph}" />
          </Button>
          <!-- Scrolls with the wheel, the trackpad and the arrow keys; a bar would lie over the tabs, as Fluent's bars overlay. -->
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
          <ListBox x:Name="Tabs" Classes="tabs" ItemsSource="{Binding TabList}" SelectionMode="Single,AlwaysSelected"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="{x:Static res:Strings.TabsName}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="shell:TerminalTab">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Panel Width="7" Height="7" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsAgentActing}" />
                    <Ellipse Fill="{DynamicResource WaitingBrush}" IsVisible="{Binding AgentNeedsUser}" />
                  </Panel>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <c:Badge Text="{Binding Environment}" IsVisible="{Binding HasEnvironment}" Classes.danger="{Binding IsProduction}" />
                  <Button Classes="icon tabclose" Command="{Binding CloseCommand}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding CloseName}" ToolTip.Tip="{Binding CloseName}">
                    <PathIcon Data="{StaticResource CloseGlyph}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Documents open from the sidebar, after the terminals. -->
          <ListBox x:Name="DocumentTabs" Classes="tabs" SelectionMode="Single" Padding="0,4,6,4"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="{x:Static res:Strings.DocumentTabsName}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="ed:IOpenDocument">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource LabelBrush}" IsVisible="{Binding IsUnsaved}" VerticalAlignment="Center" />
                  <Path Data="{StaticResource DocumentTabGlyph}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                        Stroke="{DynamicResource SecondaryLabelBrush}" StrokeThickness="1.25" StrokeJoin="Round" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Classes="icon tabclose" Command="{Binding CloseCommand}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding CloseName}" ToolTip.Tip="{Binding CloseName}">
                    <PathIcon Data="{StaticResource CloseGlyph}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border x:Name="FindBar" DockPanel.Dock="Top" IsVisible="False" Padding="8,6" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button x:Name="FindClose" DockPanel.Dock="Right" Classes="icon" Margin="4,0,0,0"
                  ToolTip.Tip="{x:Static res:Strings.FindClose}" AutomationProperties.Name="{x:Static res:Strings.FindClose}">
            <PathIcon Data="{StaticResource CloseGlyph}" Width="10" Height="10" />
          </Button>
          <Button x:Name="FindNewer" DockPanel.Dock="Right" Content="{x:Static res:Strings.FindNewer}" Margin="4,0,0,0" />
          <Button x:Name="FindOlder" DockPanel.Dock="Right" Content="{x:Static res:Strings.FindOlder}" Margin="4,0,0,0" />
          <ToggleButton x:Name="FindPattern" DockPanel.Dock="Right" Content=".*" FontFamily="{DynamicResource MonoFont}" Margin="4,0,0,0"
                        ToolTip.Tip="{x:Static res:Strings.FindPattern}" AutomationProperties.Name="{x:Static res:Strings.FindPattern}" />
          <TextBlock x:Name="FindStatus" DockPanel.Dock="Right" Classes="quiet" VerticalAlignment="Center" Margin="8,0" />
          <TextBox x:Name="FindBox" PlaceholderText="{x:Static res:Strings.FindPlaceholder}" AutomationProperties.Name="{x:Static res:Strings.FindPlaceholder}" />
        </DockPanel>
      </Border>
      <Panel>
        <Grid x:Name="TerminalHost" />
        <!-- With every terminal closed, the window stays: its sidebar, documents and chat are the workspace's. -->
        <StackPanel x:Name="NoTerminals" IsVisible="False" Spacing="6" MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Classes="title" Text="{x:Static res:Strings.NoTerminalsTitle}" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.NoTerminalsMessage}" TextWrapping="Wrap" TextAlignment="Center" />
          <Button x:Name="OpenTerminalButton" Classes="primary" Content="{x:Static res:Strings.NoTerminalsOpen}" HorizontalAlignment="Center"
                  Margin="0,8,0,0" Click="OnOpenTerminalClicked" />
        </StackPanel>
        <!-- A document in front of the terminals, which keep running and keep their size behind it. -->
        <ContentControl x:Name="DocumentHost" IsVisible="False" />
      </Panel>
    </DockPanel>
    <!-- A hairline separator, with a wider invisible handle for dragging. -->
    <Rectangle x:Name="ChatSeparator" Grid.Column="1" Fill="{DynamicResource SeparatorBrush}" />
    <GridSplitter x:Name="ChatSplitter" Grid.Column="1" ResizeDirection="Columns" Margin="-3,0" ZIndex="1" />
    <chat:ChatView x:Name="Chat" Grid.Column="2" AutomationProperties.AutomationId="Chat" />
    </Grid>
    </Grid>
  </Grid>
</Window>
