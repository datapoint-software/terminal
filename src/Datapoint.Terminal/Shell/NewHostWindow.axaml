<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
        x:Class="Datapoint.Terminal.Shell.NewHostWindow"
        Title="{res:Tr NewHostTitle}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GroupedBackgroundBrush}">
  <Window.Styles>
    <!-- An SSH config alias: a small rounded chip that fills in the form. -->
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0.5" />
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="{StaticResource SmallSize}" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="24,20">
    <TextBlock x:Name="TitleText" Classes="dialogTitle" Text="{res:Tr NewHostTitle}" />
    <TextBlock Classes="secondary" Margin="0,2,0,14" Text="{res:Tr NewHostCaption}" />
    <Border Classes="group">
      <StackPanel>
        <Grid Classes="row" ColumnDefinitions="104,*">
          <TextBlock x:Name="NameLabel" Text="{res:Tr NewHostName}" />
          <TextBox x:Name="NameBox" Grid.Column="1" MaxLength="40" AutomationProperties.Name="{res:Tr NewHostName}" />
        </Grid>
        <Rectangle Classes="hairline" />
        <Grid Classes="row" ColumnDefinitions="104,*">
          <TextBlock Text="{res:Tr NewHostAddress}" />
          <TextBox x:Name="AddressBox" Grid.Column="1" MaxLength="253" PlaceholderText="{res:Tr NewHostAddressHint}"
                   AutomationProperties.Name="{res:Tr NewHostAddress}" />
        </Grid>
        <Rectangle Classes="hairline" />
        <Grid Classes="row" ColumnDefinitions="104,*">
          <TextBlock Text="{res:Tr NewHostUser}" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto,72">
            <TextBox x:Name="UserBox" MaxLength="64" AutomationProperties.Name="{res:Tr NewHostUser}" />
            <TextBlock Grid.Column="1" Classes="quiet" Margin="12,0,8,0" VerticalAlignment="Center"
                       Text="{res:Tr NewHostPort}" />
            <TextBox x:Name="PortBox" Grid.Column="2" MaxLength="5" PlaceholderText="22" FontFamily="{StaticResource MonoFont}"
                     AutomationProperties.Name="{res:Tr NewHostPort}" />
          </Grid>
        </Grid>
        <Rectangle Classes="hairline" />
        <Grid Classes="row" ColumnDefinitions="104,*">
          <TextBlock Text="{res:Tr NewHostEnvironment}" />
          <ListBox x:Name="EnvironmentList" Grid.Column="1" Classes="segmented" SelectedIndex="0"
                   AutomationProperties.Name="{res:Tr NewHostEnvironment}" />
        </Grid>
        <Rectangle Classes="hairline" />
        <Grid Classes="row" ColumnDefinitions="104,*">
          <TextBlock Text="{res:Tr NewHostLabels}" />
          <TextBox x:Name="LabelsBox" Grid.Column="1" MaxLength="400" PlaceholderText="{res:Tr NewHostLabelsHint}"
                   AutomationProperties.Name="{res:Tr NewHostLabels}" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock x:Name="ProductionNote" Classes="secondary" Margin="4,6,4,0" IsVisible="False"
               Text="{res:Tr NewHostProductionNote}" />
    <TextBlock x:Name="LeavingProductionNote" Classes="secondary" Margin="4,6,4,0" IsVisible="False" TextWrapping="Wrap"
               Text="{res:Tr EditHostLeavingProduction}" />
    <TextBlock x:Name="MovingNote" Classes="secondary" Margin="4,6,4,0" IsVisible="False" TextWrapping="Wrap"
               Text="{res:Tr EditHostMoving}" />
    <WrapPanel x:Name="LabelPanel" Margin="4,10,0,0" ItemSpacing="6" LineSpacing="6" IsVisible="False">
      <TextBlock Classes="secondary" Margin="0,0,4,0" VerticalAlignment="Center" Text="{res:Tr NewHostLabelsUsed}" />
    </WrapPanel>
    <WrapPanel x:Name="AliasPanel" Margin="4,10,0,0" ItemSpacing="6" LineSpacing="6" IsVisible="False">
      <TextBlock Classes="secondary" Margin="0,0,4,0" VerticalAlignment="Center" Text="{res:Tr NewHostFromConfig}" />
    </WrapPanel>
    <TextBlock x:Name="Problem" Classes="secondary danger" Margin="4,10,4,0" IsVisible="False" />
    <DockPanel Margin="4,20,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Content="{res:Tr Cancel}" />
        <Button x:Name="AddButton" Classes="primary" IsDefault="True" Content="{res:Tr NewHostAdd}" />
      </StackPanel>
      <TextBlock Classes="secondary" VerticalAlignment="Center" Margin="0,0,12,0" Text="{res:Tr NewHostLogin}" />
    </DockPanel>
  </StackPanel>
</Window>
