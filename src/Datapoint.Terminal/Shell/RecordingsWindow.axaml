<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
        xmlns:controls="clr-namespace:Datapoint.Terminal.Controls;assembly=Datapoint.Terminal.Controls"
        x:Class="Datapoint.Terminal.Shell.RecordingsWindow"
        Title="{x:Static res:Strings.RecordingsTitle}"
        Width="1100" Height="680" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GroupedBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <Button x:Name="DeleteButton" Content="{x:Static res:Strings.RecordingsDelete}" IsEnabled="False" />
      <TextBlock Grid.Column="1" x:Name="Status" Classes="secondary" Text="{x:Static res:Strings.RecordingsNote}"
                 VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" />
      <Button Grid.Column="2" x:Name="CloseButton" Content="{x:Static res:Strings.Close}" />
    </Grid>
    <Grid ColumnDefinitions="260,12,*">
      <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0.5">
        <Panel>
          <ListBox x:Name="List" Background="Transparent" AutomationProperties.Name="{x:Static res:Strings.RecordingsList}" />
          <TextBlock x:Name="Empty" Classes="secondary" Text="{x:Static res:Strings.RecordingsEmpty}" TextWrapping="Wrap" Margin="16" IsVisible="False" />
        </Panel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0.5" ClipToBounds="True">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,10">
            <Button x:Name="PlayButton" Content="{x:Static res:Strings.RecordingsPlay}" MinWidth="72" IsEnabled="False" />
            <ComboBox Grid.Column="1" x:Name="SpeedBox" Margin="8,0,0,0" MinWidth="72" AutomationProperties.Name="{x:Static res:Strings.RecordingsSpeed}" />
            <Slider Grid.Column="2" x:Name="PositionSlider" Margin="12,0" Minimum="0" Maximum="1" IsEnabled="False"
                    AutomationProperties.Name="{x:Static res:Strings.RecordingsPosition}" />
            <TextBlock Grid.Column="3" x:Name="TimeText" VerticalAlignment="Center" FontFeatures="+tnum" Text="0:00 / 0:00" />
          </Grid>
          <Border DockPanel.Dock="Bottom" Height="150" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <ListBox x:Name="Markers" Background="Transparent" AutomationProperties.Name="{x:Static res:Strings.RecordingsMarkers}" />
          </Border>
          <controls:TerminalView x:Name="Screen" Padding="12,10" Focusable="False" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
