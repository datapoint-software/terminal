<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
        xmlns:c="clr-namespace:Datapoint.Terminal.Components"
        xmlns:shell="clr-namespace:Datapoint.Terminal.Shell"
        x:Class="Datapoint.Terminal.Shell.OpenHostFileWindow"
        Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GroupedBackgroundBrush}">

  <StackPanel Margin="24,20">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="Heading" Classes="dialogTitle" VerticalAlignment="Center" />
      <c:Badge x:Name="Badge" IsVisible="False" />
    </StackPanel>
    <TextBlock Classes="secondary" Margin="0,2,0,12" Text="{x:Static res:Strings.HostFileOpenHint}" />
    <TextBox x:Name="PathBox" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{x:Static res:Strings.HostFileOpenPath}" />
    <Border Classes="inset" Padding="4" Margin="0,8,0,0" Height="220">
      <ListBox x:Name="EntryList" Classes="source" Focusable="False" AutomationProperties.Name="{x:Static res:Strings.HostFileOpenPath}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="shell:HostEntryItem">
            <TextBlock Text="{Binding Display}" Classes="mono" Classes.quiet="{Binding Entry.IsFolder}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <TextBlock x:Name="Problem" Classes="secondary danger" Margin="0,8,0,0" IsVisible="False" />
    <DockPanel Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Content="{x:Static res:Strings.Cancel}" />
        <Button x:Name="OpenButton" Classes="primary" Content="{x:Static res:Strings.HostFileOpen}" />
      </StackPanel>
      <TextBlock Classes="secondary" VerticalAlignment="Center" Margin="0,0,12,0" Text="{x:Static res:Strings.HostFileOpenNote}" />
    </DockPanel>
  </StackPanel>
</Window>
