<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
        xmlns:c="clr-namespace:Datapoint.Terminal.Components"
        x:Class="Datapoint.Terminal.Shell.SaveHostFileWindow"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GroupedBackgroundBrush}">

  <StackPanel Margin="24,20">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="Heading" Classes="dialogTitle" VerticalAlignment="Center" />
      <c:Badge x:Name="Badge" IsVisible="False" />
    </StackPanel>
    <TextBlock x:Name="Summary" Classes="secondary" Margin="0,2,0,12" />
    <Border Classes="inset">
      <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="Diff" Classes="mono" Margin="12,8" />
      </ScrollViewer>
    </Border>
    <Border x:Name="ProductionNote" Classes="callout" IsVisible="False" Margin="0,12,0,0">
      <TextBlock x:Name="ProductionText" />
    </Border>
    <TextBlock x:Name="CommandNote" Classes="secondary" Margin="0,12,0,4" />
    <Border Classes="code">
      <SelectableTextBlock x:Name="Command" Classes="mono" TextWrapping="Wrap" />
    </Border>
    <DockPanel Margin="0,18,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Content="{res:Tr Cancel}" />
        <Button x:Name="SaveButton" Classes="primary" IsDefault="True" />
      </StackPanel>
      <TextBlock x:Name="BackupNote" Classes="secondary" VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>
  </StackPanel>
</Window>
