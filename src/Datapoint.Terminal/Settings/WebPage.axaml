<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             xmlns:settings="clr-namespace:Datapoint.Terminal.Settings"
             x:Class="Datapoint.Terminal.Settings.WebPage"
             x:DataType="settings:WebViewModel">
  <StackPanel Classes="form">
    <Border Classes="group">
      <Grid Classes="row" ColumnDefinitions="*,Auto">
        <TextBlock Text="{res:Tr WebAlwaysAllow}" TextWrapping="Wrap" />
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysAllow}" OnContent="{x:Null}" OffContent="{x:Null}"
                      AutomationProperties.Name="{res:Tr WebAlwaysAllow}" />
      </Grid>
    </Border>
    <TextBlock Classes="secondary note" Text="{res:Tr WebAlwaysAllowHint}" />

    <Border Classes="group">
      <StackPanel>
        <Grid Classes="row" ColumnDefinitions="150,*">
          <TextBlock Text="{res:Tr WebSearchWith}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Services}" SelectedIndex="{Binding SelectedService}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{res:Tr WebSearchWith}" />
        </Grid>
        <!-- The key: entered once, then only replaced or removed, as for providers. -->
        <Rectangle Classes="hairline" IsVisible="{Binding NeedsKey}" />
        <Grid Classes="row" ColumnDefinitions="150,*" IsVisible="{Binding NeedsKey}">
          <TextBlock Text="{res:Tr WebKey}" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" IsVisible="{Binding ShowKeyEntry}">
            <TextBox Text="{Binding KeyDraft}" PasswordChar="•" PlaceholderText="{res:Tr ProviderKeyPlaceholder}"
                     AutomationProperties.Name="{res:Tr WebKey}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SaveKeyCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{res:Tr ProviderKeySave}" Command="{Binding SaveKeyCommand}" />
          </Grid>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !ShowKeyEntry}">
            <TextBlock Classes="quiet" Text="••••••••••••••••" VerticalAlignment="Center" IsVisible="{Binding HasSavedKey}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{res:Tr ProviderKeyReplace}" Command="{Binding ReplaceKeyCommand}"
                    IsVisible="{Binding HasSavedKey}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="{res:Tr ProviderKeyRemove}" Command="{Binding RemoveKeyCommand}"
                    IsVisible="{Binding HasSavedKey}" />
          </Grid>
        </Grid>
        <Rectangle Classes="hairline" IsVisible="{Binding NeedsServer}" />
        <Grid Classes="row" ColumnDefinitions="150,*" IsVisible="{Binding NeedsServer}">
          <TextBlock Text="{res:Tr WebServer}" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding Server}" PlaceholderText="{res:Tr WebServerPlaceholder}"
                     AutomationProperties.Name="{res:Tr WebServer}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SaveServerCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{res:Tr ProviderKeySave}" Command="{Binding SaveServerCommand}" />
          </Grid>
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Classes="secondary note" Text="{Binding KeyStatus}" IsVisible="{Binding KeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               AutomationProperties.LiveSetting="Polite" />
    <TextBlock Classes="secondary note" Text="{Binding ServerStatus}" IsVisible="{Binding ServerStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               AutomationProperties.LiveSetting="Polite" />
    <TextBlock Classes="secondary note" Text="{Binding Hint}" />
    <TextBlock Classes="secondary note" Text="{res:Tr WebReadHint}" />
  </StackPanel>
</UserControl>
