<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:Datapoint.Terminal.Settings"
        xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
        x:Class="Datapoint.Terminal.Settings.SettingsWindow"
        x:DataType="settings:SettingsViewModel"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="780" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GroupedBackgroundBrush}">
  <Window.Resources>
    <StreamGeometry x:Key="PlusGlyph">M7.25,2.5 L8.75,2.5 L8.75,7.25 L13.5,7.25 L13.5,8.75 L8.75,8.75 L8.75,13.5 L7.25,13.5 L7.25,8.75 L2.5,8.75 L2.5,7.25 L7.25,7.25 Z</StreamGeometry>
    <StreamGeometry x:Key="MinusGlyph">M2.5,7.25 L13.5,7.25 L13.5,8.75 L2.5,8.75 Z</StreamGeometry>
    <StreamGeometry x:Key="ProvidersGlyph">M10,2.5 A7.5,7.5 0 1,0 10.01,2.5 Z M10,4 A6,6 0 1,1 9.99,4 Z M9.25,6.5 L10.75,6.5 L10.75,9.25 L13.5,9.25 L13.5,10.75 L10.75,10.75 L10.75,13.5 L9.25,13.5 L9.25,10.75 L6.5,10.75 L6.5,9.25 L9.25,9.25 Z</StreamGeometry>
    <StreamGeometry x:Key="AppearanceGlyph">M10,2.5 A7.5,7.5 0 1,0 10.01,2.5 Z M10,4 L10,16 A6,6 0 0,1 10,4 Z</StreamGeometry>
    <StreamGeometry x:Key="HistoryGlyph">M10,2.5 A7.5,7.5 0 1,0 10.01,2.5 Z M10,4 A6,6 0 1,1 9.99,4 Z M9.25,6 L10.75,6 L10.75,9.6 L13.2,11.1 L12.45,12.4 L9.25,10.4 Z</StreamGeometry>
    <StreamGeometry x:Key="WebGlyph">M10,2.5 A7.5,7.5 0 1,0 10.01,2.5 Z M10,4 A6,6 0 1,1 9.99,4 Z M10,4 A3.2,6 0 1,0 10.01,4 Z M10,5.5 A1.7,4.5 0 1,1 9.99,5.5 Z M3.5,9.25 L16.5,9.25 L16.5,10.75 L3.5,10.75 Z</StreamGeometry>
    <StreamGeometry x:Key="MemoryGlyph">M5,2.5 L15,2.5 L15,17.5 L10,13.5 L5,17.5 Z M6.5,4 L6.5,14.4 L10,11.6 L13.5,14.4 L13.5,4 Z</StreamGeometry>
    <StreamGeometry x:Key="CheckGlyph">M2.5,8.5 L3.6,7.4 L6.3,10.1 L12.4,4 L13.5,5.1 L6.3,12.3 Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <!-- The pages, as a macOS settings window shows them: icons with names along the top. -->
    <Style Selector="ListBox.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.toolbar ListBoxItem">
      <Setter Property="Width" Value="84" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="ListBox.toolbar ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="ListBox.toolbar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="ListBox.toolbar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="ListBox.toolbar ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,8">
    <ListBox x:Name="Pages" Classes="toolbar" SelectedIndex="0" AutomationProperties.Name="{x:Static res:Strings.SettingsTitle}">
      <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.SettingsPageProviders}">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource ProvidersGlyph}" Width="20" Height="20" />
          <TextBlock Text="{x:Static res:Strings.SettingsPageProviders}" FontSize="{StaticResource CaptionSize}" HorizontalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.SettingsPageAppearance}">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource AppearanceGlyph}" Width="20" Height="20" />
          <TextBlock Text="{x:Static res:Strings.SettingsPageAppearance}" FontSize="{StaticResource CaptionSize}" HorizontalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.SettingsPageHistory}">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource HistoryGlyph}" Width="20" Height="20" />
          <TextBlock Text="{x:Static res:Strings.SettingsPageHistory}" FontSize="{StaticResource CaptionSize}" HorizontalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.SettingsPageMemory}">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource MemoryGlyph}" Width="20" Height="20" />
          <TextBlock Text="{x:Static res:Strings.SettingsPageMemory}" FontSize="{StaticResource CaptionSize}" HorizontalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.SettingsPageWeb}">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource WebGlyph}" Width="20" Height="20" />
          <TextBlock Text="{x:Static res:Strings.SettingsPageWeb}" FontSize="{StaticResource CaptionSize}" HorizontalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
    </ListBox>
  </Border>
  <Panel>
  <ScrollViewer x:Name="AppearanceScroller" IsVisible="False">
    <settings:AppearancePage x:Name="AppearancePage" Margin="28,22" MaxWidth="560" />
  </ScrollViewer>
  <ScrollViewer x:Name="HistoryScroller" IsVisible="False">
    <settings:HistoryPage x:Name="HistoryPage" Margin="28,22" MaxWidth="560" />
  </ScrollViewer>
  <ScrollViewer x:Name="MemoryScroller" IsVisible="False">
    <settings:MemoryPage x:Name="MemoryPage" Margin="28,22" MaxWidth="560" />
  </ScrollViewer>
  <ScrollViewer x:Name="WebScroller" IsVisible="False">
    <settings:WebPage x:Name="WebPage" Margin="28,22" MaxWidth="560" />
  </ScrollViewer>
  <Grid x:Name="ProvidersPage" ColumnDefinitions="230,1,*">
    <!-- Sidebar: the providers, with add and remove at the bottom. -->
    <DockPanel Background="{DynamicResource PaneBrush}">
      <TextBlock DockPanel.Dock="Top" Classes="section" Margin="18,16,0,8" Text="{x:Static res:Strings.SettingsProviders}" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="2" Margin="10,8">
        <Button Classes="icon" Command="{Binding AddCommand}" ToolTip.Tip="{x:Static res:Strings.SettingsAdd}"
                AutomationProperties.Name="{x:Static res:Strings.SettingsAdd}">
          <PathIcon Data="{StaticResource PlusGlyph}" />
        </Button>
        <Button Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="{x:Static res:Strings.SettingsRemove}"
                AutomationProperties.Name="{x:Static res:Strings.SettingsRemove}">
          <PathIcon Data="{StaticResource MinusGlyph}" />
        </Button>
      </StackPanel>
      <ListBox Classes="source" Margin="8,0" ItemsSource="{Binding Providers}" SelectedItem="{Binding Selected}"
               AutomationProperties.Name="{x:Static res:Strings.SettingsProviders}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="settings:ProviderViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="2,6">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{Binding Model}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <PathIcon Grid.Column="1" Data="{StaticResource CheckGlyph}" Width="13" Height="13" Margin="6,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsActive}"
                        AutomationProperties.Name="{x:Static res:Strings.ProviderInUse}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Rectangle Grid.Column="1" Fill="{DynamicResource SeparatorBrush}" />

    <!-- Nothing yet: say what a provider is for. -->
    <StackPanel Grid.Column="2" IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Spacing="14">
      <TextBlock Text="{x:Static res:Strings.SettingsEmpty}" TextWrapping="Wrap" TextAlignment="Center" />
      <Button Classes="primary" HorizontalAlignment="Center" Content="{x:Static res:Strings.SettingsAdd}" Command="{Binding AddCommand}" />
    </StackPanel>

    <ScrollViewer Grid.Column="2" IsVisible="{Binding HasSelection}">
      <StackPanel Classes="form" Margin="28,22" MaxWidth="560" DataContext="{Binding Selected}" x:DataType="settings:ProviderViewModel">
        <!-- Which provider, and which model. -->
        <Border Classes="group">
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderKind}" />
              <ListBox Grid.Column="1" Classes="segmented" ItemsSource="{Binding $parent[Window].((settings:SettingsViewModel)DataContext).Kinds}"
                       SelectedItem="{Binding Kind}" AutomationProperties.Name="{x:Static res:Strings.ProviderKind}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="settings:KindOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <Rectangle Classes="hairline" />
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderName}" />
              <TextBox Grid.Column="1" Text="{Binding Name}" AutomationProperties.Name="{x:Static res:Strings.ProviderName}" />
            </Grid>
            <Rectangle Classes="hairline" />
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderModel}" />
              <AutoCompleteBox Grid.Column="1" Text="{Binding Model}" ItemsSource="{Binding ModelSuggestions}"
                               MinimumPrefixLength="0" FilterMode="StartsWith"
                               AutomationProperties.Name="{x:Static res:Strings.ProviderModel}" />
            </Grid>
            <Rectangle Classes="hairline" />
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderContextWindow}" />
              <TextBox Grid.Column="1" Text="{Binding ContextWindow}" PlaceholderText="{x:Static res:Strings.ProviderContextWindowHint}"
                       AutomationProperties.Name="{x:Static res:Strings.ProviderContextWindow}" />
            </Grid>
            <Rectangle Classes="hairline" />
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderOutputLimit}" />
              <TextBox Grid.Column="1" Text="{Binding OutputLimit}" PlaceholderText="{Binding OutputLimitHint}"
                       AutomationProperties.Name="{x:Static res:Strings.ProviderOutputLimit}" />
            </Grid>
            <Rectangle Classes="hairline" />
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderInputPrice}" TextWrapping="Wrap" />
              <TextBox Grid.Column="1" Text="{Binding InputPrice}" PlaceholderText="{x:Static res:Strings.ProviderPriceHint}"
                       AutomationProperties.Name="{x:Static res:Strings.ProviderInputPrice}" />
            </Grid>
            <Rectangle Classes="hairline" />
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderOutputPrice}" TextWrapping="Wrap" />
              <TextBox Grid.Column="1" Text="{Binding OutputPrice}" PlaceholderText="{x:Static res:Strings.ProviderPriceHint}"
                       AutomationProperties.Name="{x:Static res:Strings.ProviderOutputPrice}" />
            </Grid>
            <Rectangle Classes="hairline" />
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderCachedInputPrice}" TextWrapping="Wrap" />
              <TextBox Grid.Column="1" Text="{Binding CachedInputPrice}" PlaceholderText="{x:Static res:Strings.ProviderCachedPriceHint}"
                       AutomationProperties.Name="{x:Static res:Strings.ProviderCachedInputPrice}"
                       AutomationProperties.HelpText="{x:Static res:Strings.ProviderCachedPriceHint}" />
            </Grid>
            <StackPanel IsVisible="{Binding IsCompatible}">
              <Rectangle Classes="hairline" />
              <Grid Classes="row" ColumnDefinitions="150,*">
                <TextBlock Text="{x:Static res:Strings.ProviderEndpoint}" />
                <TextBox Grid.Column="1" Text="{Binding Endpoint}" PlaceholderText="{x:Static res:Strings.ProviderEndpointHint}"
                         AutomationProperties.Name="{x:Static res:Strings.ProviderEndpoint}" />
              </Grid>
              <Rectangle Classes="hairline" />
              <Grid Classes="row" ColumnDefinitions="150,*">
                <CheckBox Grid.Column="1" IsChecked="{Binding IsLocal}" Content="{x:Static res:Strings.ProviderIsLocal}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- The key: entered once, then only replaced or removed. -->
        <Border Classes="group">
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*">
              <TextBlock Text="{x:Static res:Strings.ProviderApiKey}" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" IsVisible="{Binding ShowKeyEntry}">
                <TextBox Text="{Binding KeyDraft}" PasswordChar="•" PlaceholderText="{x:Static res:Strings.ProviderKeyPlaceholder}"
                         AutomationProperties.Name="{x:Static res:Strings.ProviderApiKey}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SaveKeyCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static res:Strings.ProviderKeySave}" Command="{Binding SaveKeyCommand}" />
              </Grid>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !ShowKeyEntry}">
                <TextBlock Classes="quiet" Text="••••••••••••••••" VerticalAlignment="Center" IsVisible="{Binding HasSavedKey}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static res:Strings.ProviderKeyReplace}" Command="{Binding ReplaceKeyCommand}"
                        IsVisible="{Binding HasSavedKey}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="{x:Static res:Strings.ProviderKeyRemove}" Command="{Binding RemoveKeyCommand}"
                        IsVisible="{Binding HasSavedKey}" />
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Classes="secondary note" Text="{Binding KeyStatus}" IsVisible="{Binding KeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Where the conversation goes, and whether it works. -->
        <TextBlock Classes="secondary" Text="{Binding Privacy}" Margin="4,0,0,12" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static res:Strings.ProviderTest}" Command="{Binding TestCommand}" />
          <Button Classes="primary" Content="{x:Static res:Strings.ProviderUse}" Command="{Binding UseCommand}" IsVisible="{Binding !IsActive}" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsActive}">
            <PathIcon Data="{StaticResource CheckGlyph}" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{x:Static res:Strings.ProviderInUse}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <TextBlock Classes="secondary" Classes.danger="{Binding TestFailed}" Text="{Binding TestResult}" Margin="4,10,0,0"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </Panel>
  </DockPanel>
</Window>
