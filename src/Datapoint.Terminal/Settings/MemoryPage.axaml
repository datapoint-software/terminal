<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             xmlns:settings="clr-namespace:Datapoint.Terminal.Settings"
             x:Class="Datapoint.Terminal.Settings.MemoryPage"
             x:DataType="settings:MemoryPageViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="EditGlyph">M10.5,2.5 L13.5,5.5 L5.5,13.5 L2.5,13.5 L2.5,10.5 Z M9,4 L12,7</StreamGeometry>
    <StreamGeometry x:Key="DeleteGlyph">M2.5,4 L13.5,4 M6,4 L6,2.5 L10,2.5 L10,4 M4,4 L4.75,13.5 L11.25,13.5 L12,4</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Path.glyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stroke" Value="{DynamicResource SecondaryLabelBrush}" />
      <Setter Property="StrokeThickness" Value="1.25" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    </Style>
    <Style Selector="Border.note">
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="14,8,8,8" />
    </Style>
    <Style Selector="ContentPresenter:nth-child(1) > Border.note">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="secondary" Text="{x:Static res:Strings.MemoryIntro}" Margin="4,0,4,18" />
    <ItemsControl ItemsSource="{Binding Sections}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="settings:MemorySectionViewModel">
          <StackPanel Margin="0,0,0,18">
            <DockPanel Margin="4,0,4,6">
              <Button DockPanel.Dock="Right" Classes="plain danger" Content="{x:Static res:Strings.MemoryClear}"
                      IsVisible="{Binding CanClear}" Command="{Binding ClearCommand}" AutomationProperties.Name="{Binding ClearName}" />
              <TextBlock Classes="heading" Margin="0" Text="{Binding Title}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Classes="group" Margin="0">
              <StackPanel>
                <TextBlock Classes="secondary" Text="{x:Static res:Strings.MemoryEmpty}" IsVisible="{Binding !HasNotes}" Margin="14,12" />
                <ItemsControl ItemsSource="{Binding Notes}" AutomationProperties.Name="{Binding Title}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="settings:MemoryNoteViewModel">
                      <Border Classes="note">
                        <Panel>
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" IsVisible="{Binding !IsEditing}">
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" IsVisible="{Binding CanWrite}" Command="{Binding EditCommand}"
                                    ToolTip.Tip="{Binding EditName}" AutomationProperties.Name="{Binding EditName}">
                              <Path Classes="glyph" Data="{StaticResource EditGlyph}" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon" IsVisible="{Binding CanWrite}" Command="{Binding DeleteCommand}"
                                    ToolTip.Tip="{Binding DeleteName}" AutomationProperties.Name="{Binding DeleteName}">
                              <Path Classes="glyph" Data="{StaticResource DeleteGlyph}" />
                            </Button>
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding IsEditing}">
                            <TextBox Text="{Binding EditText}" MaxLength="300" TextWrapping="Wrap" AutomationProperties.Name="{Binding EditName}" />
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="primary" Content="{x:Static res:Strings.MemorySave}" Command="{Binding SaveCommand}" VerticalAlignment="Center" />
                          </Grid>
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Classes="secondary" Text="{x:Static res:Strings.MemoryReadOnly}" IsVisible="{Binding !CanWrite}" Margin="4,6,4,0" />
            <TextBlock Classes="secondary" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DangerBrush}" Margin="4,6,4,0" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="secondary" Text="{x:Static res:Strings.MemoryFooter}" Margin="4,0" />
  </StackPanel>
</UserControl>
