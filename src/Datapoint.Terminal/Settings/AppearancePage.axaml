<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Datapoint.Terminal.Settings"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             x:Class="Datapoint.Terminal.Settings.AppearancePage"
             x:DataType="settings:AppearanceViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.themes ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.themes ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    </Style>
    <Style Selector="ListBox.themes ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.themes ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TextBlock.preview">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    </Style>
  </UserControl.Styles>

  <!-- The window first, then the terminal: each setting sits under what it changes. -->
  <StackPanel Classes="form">
    <TextBlock Classes="heading" Text="{res:Tr AppearanceLanguageHeading}" />
    <Border Classes="group">
      <Grid Classes="row" ColumnDefinitions="*,Auto">
        <TextBlock Text="{res:Tr AppearanceLanguage}" />
        <ComboBox x:Name="LanguageChoice" Grid.Column="1" MinWidth="200" ItemsSource="{Binding Languages}" SelectedIndex="{Binding SelectedLanguage}"
                  AutomationProperties.Name="{res:Tr AppearanceLanguage}" />
      </Grid>
    </Border>
    <TextBlock Classes="secondary note" TextWrapping="Wrap" Text="{res:Tr AppearanceLanguageHint}" />

    <TextBlock Classes="heading" Text="{res:Tr AppearanceWindowHeading}" />
    <Border Classes="group">
      <StackPanel>
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <TextBlock Text="{res:Tr AppearanceWindowTheme}" />
          <ListBox Grid.Column="1" Classes="segmented" ItemsSource="{Binding WindowThemes}" SelectedIndex="{Binding SelectedWindowTheme}"
                   AutomationProperties.Name="{res:Tr AppearanceWindowThemeName}" />
        </Grid>
        <Rectangle Classes="hairline" />
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <TextBlock Text="{res:Tr AppearanceReduceMotion}" TextWrapping="Wrap" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion}" OnContent="{x:Null}" OffContent="{x:Null}"
                        AutomationProperties.Name="{res:Tr AppearanceReduceMotion}" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Classes="secondary note" TextWrapping="Wrap">
      <Run Text="{res:Tr AppearanceWindowThemeHint}" />
      <Run Text="{res:Tr AppearanceReduceMotionHint}" />
    </TextBlock>

    <TextBlock Classes="heading" Text="{res:Tr AppearanceTerminalHeading}" />
    <!-- No padding, so the cards line up with the buttons and the group below; three to a row, sharing the width. -->
    <ListBox x:Name="ThemeList" Classes="themes" Background="Transparent" Padding="0" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
             AutomationProperties.Name="{res:Tr AppearanceThemeHeading}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" ColumnSpacing="10" RowSpacing="10" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="settings:ThemeCard">
          <Border Classes="inset" ClipToBounds="True"
                  AutomationProperties.Name="{Binding AccessibleName}">
            <Border.ContextMenu>
              <ContextMenu IsVisible="{Binding IsCustom}">
                <MenuItem Header="{res:Tr ThemeRemove}" Click="OnRemoveClicked" />
              </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
              <Border Background="{Binding Background}" Padding="10,8" Height="56">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="preview" Text="~/app" Foreground="{Binding Prompt}" />
                    <TextBlock Classes="preview" Text=" $ ls" Foreground="{Binding Foreground}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="preview" Text="src" Foreground="{Binding Folder}" />
                    <TextBlock Classes="preview" Text="deploy.sh" Foreground="{Binding File}" />
                    <TextBlock Classes="preview" Text="README" Foreground="{Binding Foreground}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="Auto,*" Margin="10,6">
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource SmallSize}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="secondary" IsVisible="{Binding HasNote}" VerticalAlignment="Center"
                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="ImportButton" Content="{res:Tr ThemeImport}" />
      <Button x:Name="EditButton" Content="{res:Tr ThemeEditColors}" />
    </StackPanel>
    <TextBlock Classes="secondary" Text="{res:Tr ThemeImportHint}" TextWrapping="Wrap" Margin="4,6,4,0" />
    <TextBlock x:Name="ImportStatus" Classes="secondary danger" Margin="4,4,4,0" IsVisible="False" AutomationProperties.LiveSetting="Polite" />

    <Border Classes="group" Margin="0,14,0,0">
      <StackPanel>
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <TextBlock Text="{res:Tr AppearanceFont}" />
          <ComboBox x:Name="FontChoice" Grid.Column="1" MinWidth="180" ItemsSource="{Binding Fonts}" SelectedIndex="{Binding SelectedFont}"
                    AutomationProperties.Name="{res:Tr AppearanceFont}" />
        </Grid>
        <Rectangle Classes="hairline" />
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <TextBlock Text="{res:Tr AppearanceTextSize}" />
          <ComboBox Grid.Column="1" MinWidth="180" ItemsSource="{Binding Sizes}" SelectedIndex="{Binding SelectedSize}"
                    AutomationProperties.Name="{res:Tr AppearanceTextSize}" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
