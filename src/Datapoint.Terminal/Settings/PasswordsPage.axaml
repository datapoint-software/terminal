<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             xmlns:settings="clr-namespace:Datapoint.Terminal.Settings"
             x:Class="Datapoint.Terminal.Settings.PasswordsPage"
             x:DataType="settings:PasswordsViewModel">
  <StackPanel Classes="form">
    <TextBlock Classes="heading" Text="{x:Static res:Strings.PasswordsHeading}" />
    <Border Classes="group">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Logins}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="settings:SavedLoginViewModel">
              <StackPanel>
                <Rectangle Classes="hairline" IsVisible="{Binding !IsFirst}" />
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <SelectableTextBlock Classes="mono" Text="{Binding Login}" TextWrapping="Wrap" />
                  <CheckBox Grid.Column="1" Margin="8,0,0,0" Content="{x:Static res:Strings.PasswordsAlways}" IsChecked="{Binding UsesWithoutAsking}"
                            AutomationProperties.Name="{Binding UsesWithoutAskingName}" />
                  <Button Grid.Column="2" Margin="8,0,0,0" Content="{x:Static res:Strings.PasswordsForget}" Command="{Binding ForgetCommand}"
                          AutomationProperties.Name="{Binding ForgetName}" />
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Classes="row" IsVisible="{Binding !HasLogins}">
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.PasswordsNone}" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Classes="secondary note" Text="{Binding Hint}" />
    <TextBlock Classes="secondary note" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
