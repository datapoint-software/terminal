<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             x:Class="Datapoint.Terminal.App"
             Name="Datapoint Terminal"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Datapoint.Terminal/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://Datapoint.Terminal/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://Datapoint.Terminal/Styles/Components.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <!-- Choices whose text follows the interface's language (product decision 150). -->
  <Application.DataTemplates>
    <DataTemplate DataType="res:TextChoice" x:DataType="res:TextChoice">
      <TextBlock Text="{Binding Text}" />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Datapoint.Terminal/Styles/Controls.axaml" />
    <StyleInclude Source="avares://Datapoint.Terminal/Styles/Text.axaml" />
    <StyleInclude Source="avares://Datapoint.Terminal/Styles/Surfaces.axaml" />
    <StyleInclude Source="avares://Datapoint.Terminal/Styles/Overlays.axaml" />
  </Application.Styles>
  <!-- macOS application menu: About first, then Settings… with Cmd+, as every Mac app has. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{res:Tr MenuAbout}" Click="OnAboutClicked" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="Settings…" Gesture="Meta+OemComma" Click="OnSettingsClicked" />
    </NativeMenu>
  </NativeMenu.Menu>
</Application>
