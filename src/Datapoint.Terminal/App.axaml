<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Datapoint.Terminal.App"
             Name="Datapoint Terminal"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Datapoint.Terminal/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Datapoint.Terminal/Styles/Controls.axaml" />
  </Application.Styles>
  <!-- macOS application menu: Settings… with Cmd+, as every Mac app has. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Settings…" Gesture="Meta+OemComma" Click="OnSettingsClicked" />
    </NativeMenu>
  </NativeMenu.Menu>
</Application>
