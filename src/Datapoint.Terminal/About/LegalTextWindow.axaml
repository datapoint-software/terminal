<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Datapoint.Terminal.About.LegalTextWindow"
        Width="680" Height="600" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GroupedBackgroundBrush}">
  <ScrollViewer>
    <SelectableTextBlock x:Name="Body" Classes="mono" TextWrapping="Wrap" Margin="20" />
  </ScrollViewer>
</Window>
