<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:side="clr-namespace:Datapoint.Terminal.Sidebar"
             xmlns:res="clr-namespace:Datapoint.Terminal.Resources"
             xmlns:c="clr-namespace:Datapoint.Terminal.Components"
             x:Class="Datapoint.Terminal.Sidebar.SidebarView"
             x:DataType="side:SidebarViewModel"
             AutomationProperties.Name="{x:Static res:Strings.SidebarLabel}">
  <UserControl.Resources>
    <!-- Our own outline glyphs, 16 by 16, drawn with a stroke. -->
    <StreamGeometry x:Key="ServerGlyph">M3,2.5 L13,2.5 L13,7 L3,7 Z M3,9 L13,9 L13,13.5 L3,13.5 Z M5,4.75 L6,4.75 M5,11.25 L6,11.25</StreamGeometry>
    <StreamGeometry x:Key="DocumentGlyph">M3.75,1.75 L9.5,1.75 L12.25,4.5 L12.25,14.25 L3.75,14.25 Z M9.5,1.75 L9.5,4.5 L12.25,4.5 M5.75,8 L10.25,8 M5.75,10.5 L10.25,10.5</StreamGeometry>
    <StreamGeometry x:Key="SkillGlyph">M2.5,4 L3.5,5 L5,3 M2.5,8.5 L3.5,9.5 L5,7.5 M2.5,13 L3.5,14 L5,12 M7,4 L13.5,4 M7,8.5 L13.5,8.5 M7,13 L13.5,13</StreamGeometry>
    <StreamGeometry x:Key="UpDownGlyph">M5,6 L8,3 L11,6 M5,10 L8,13 L11,10</StreamGeometry>
    <StreamGeometry x:Key="SlidersGlyph">M2,5 L14,5 M2,11 L14,11 M10,3 L10,7 M6,9 L6,13</StreamGeometry>
    <StreamGeometry x:Key="ChevronGlyph">M6,4 L10,8 L6,12</StreamGeometry>
    <StreamGeometry x:Key="AddGlyph">M8,3 L8,13 M3,8 L13,8</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- The environment mark, set on the host's glyph. -->
    <Style Selector="Ellipse.environment">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,-2,3" />
      <Setter Property="Stroke" Value="{DynamicResource PaneBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource PaneBrush}">
    <!-- The workspace switcher: the workspace in this window, and a menu of the others. -->
    <Border DockPanel.Dock="Top" Height="{StaticResource PaneHeaderHeight}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <Button x:Name="SwitcherButton" Classes="row" Padding="8,6" CornerRadius="{StaticResource BlockRadius}" Margin="8,0" VerticalAlignment="Center"
              AutomationProperties.Name="{Binding WorkspaceAccessibleName}" ToolTip.Tip="{Binding WorkspaceFolder}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:Avatar Text="{Binding WorkspaceInitials}" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="secondary" Text="{Binding WorkspaceDetail}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Path Grid.Column="2" Classes="glyph" Data="{StaticResource UpDownGlyph}" />
        </Grid>
      </Button>
    </Border>

    <StackPanel DockPanel.Dock="Bottom">
      <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" />
      <Button Classes="row" Margin="10,6" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="{x:Static res:Strings.SidebarSettings}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="glyph" Data="{StaticResource SlidersGlyph}" />
          <TextBlock Text="{x:Static res:Strings.SidebarSettings}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="10,12,10,16">
        <!-- Hosts: the workspace's connections, then a quiet line for the user's other SSH hosts. -->
        <Grid x:Name="HostsHeader" ColumnDefinitions="*,Auto" Margin="8,0,0,4" Height="24">
          <TextBlock Classes="section" Text="{x:Static res:Strings.SidebarHosts}" />
          <Button Grid.Column="1" Classes="icon small" Command="{Binding NewHostCommand}"
                  ToolTip.Tip="{x:Static res:Strings.NewHostTitle}" AutomationProperties.Name="{x:Static res:Strings.NewHostTitle}">
            <Path Classes="glyph" Data="{StaticResource AddGlyph}" />
          </Button>
        </Grid>
        <TextBlock Classes="secondary" Text="{x:Static res:Strings.SidebarNoHosts}" IsVisible="{Binding !HasHosts}" Margin="8,2,8,4" />
        <ListBox x:Name="HostList" Classes="source" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" SelectionMode="Single"
                 AutomationProperties.Name="{x:Static res:Strings.SidebarHosts}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="side:HostItemViewModel">
              <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" Background="Transparent"
                    AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding Environment}">
                <Grid.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="{x:Static res:Strings.SidebarOpenDocumentation}"
                              Command="{Binding $parent[side:SidebarView].((side:SidebarViewModel)DataContext).ChooseHostCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{x:Static res:Strings.SidebarOpenTerminal}"
                              Command="{Binding $parent[side:SidebarView].((side:SidebarViewModel)DataContext).OpenTerminalCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.SidebarEditHost}"
                              Command="{Binding $parent[side:SidebarView].((side:SidebarViewModel)DataContext).EditHostCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{x:Static res:Strings.SidebarRemoveHost}"
                              Command="{Binding $parent[side:SidebarView].((side:SidebarViewModel)DataContext).RemoveHostCommand}" CommandParameter="{Binding}" />
                  </MenuFlyout>
                </Grid.ContextFlyout>
                <Panel>
                  <Path Classes="glyph" Data="{StaticResource ServerGlyph}" />
                  <Ellipse Classes="environment" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsProduction}" />
                  <Ellipse Classes="environment" Fill="{DynamicResource WaitingBrush}" IsVisible="{Binding IsStaging}" />
                  <Ellipse Classes="environment" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsOtherEnvironment}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="secondary" VerticalAlignment="Center" Text="{Binding OpenText}" IsVisible="{Binding IsOpen}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Classes="row" Command="{Binding ToggleOtherHostsCommand}" IsVisible="{Binding HasOtherHosts}"
                AutomationProperties.Name="{Binding OtherHostsText}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="glyph" Data="{StaticResource ChevronGlyph}">
              <Path.RenderTransform>
                <RotateTransform Angle="{Binding OtherHostsChevronAngle}" />
              </Path.RenderTransform>
            </Path>
            <TextBlock Classes="secondary" Text="{Binding OtherHostsText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding OtherHosts}" IsVisible="{Binding IsOtherHostsExpanded}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="side:SshHostItemViewModel">
              <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" Height="{StaticResource RowHeight}" Margin="8,0,0,0">
                <Path Classes="glyph" Data="{StaticResource ServerGlyph}" Opacity="0.6" />
                <TextBlock Grid.Column="1" Classes="quiet" Text="{Binding Alias}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="plain" Content="{x:Static res:Strings.SidebarAdd}" Command="{Binding AddCommand}"
                        AutomationProperties.Name="{Binding Alias, StringFormat={x:Static res:Strings.SidebarAddHost}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Skills: saved by the agent, opened here. -->
        <TextBlock x:Name="SkillsHeader" Classes="section" Margin="8,18,0,4" Height="24" Text="{x:Static res:Strings.SidebarSkills}" />
        <TextBlock Classes="secondary" Text="{x:Static res:Strings.SidebarNoSkills}" IsVisible="{Binding !HasSkills}" Margin="8,2,8,4" />
        <ListBox x:Name="SkillList" Classes="source" ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}" SelectionMode="Single"
                 AutomationProperties.Name="{x:Static res:Strings.SidebarSkills}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="side:SkillItemViewModel">
              <Grid ColumnDefinitions="16,*" ColumnSpacing="8" Background="Transparent" AutomationProperties.Name="{Binding Name}">
                <Path Classes="glyph" Data="{StaticResource SkillGlyph}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- The workspace's own instructions for the agent. -->
        <TextBlock Classes="section" Margin="8,18,0,4" Height="24" Text="{x:Static res:Strings.SidebarWorkspaceSection}" />
        <Button Classes="row" Command="{Binding OpenInstructionsCommand}" AutomationProperties.Name="{x:Static res:Strings.SidebarInstructions}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="glyph" Data="{StaticResource DocumentGlyph}" />
            <TextBlock Text="{x:Static res:Strings.SidebarInstructions}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
