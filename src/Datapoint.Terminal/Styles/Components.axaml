<!-- The application's own controls. Each has one theme here, so it looks the same in every view. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Datapoint.Terminal.Components"
                    xmlns:chat="clr-namespace:Datapoint.Terminal.Chat">
  <ControlTheme x:Key="{x:Type c:Badge}" TargetType="c:Badge">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                     FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- Production, the environment where a mistake costs most. -->
    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^.accent">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource WarningFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
    </Style>
    <!-- A label the user gave a host: quieter than its environment. -->
    <Style Selector="^.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,0" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:Avatar}" TargetType="c:Avatar">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                     FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- A host named on a look request or a plan: a terminal mark, its name as the terminal shows it, and its environment, red
       for production. Outlined on the pane colour, so it reads as a name rather than a button or a tag. -->
  <DataTemplate x:Key="HostChip" x:DataType="chat:HostChipViewModel">
    <Border Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
            CornerRadius="{StaticResource ControlRadius}" Padding="5,1,3,1" Margin="0,0,4,4" AutomationProperties.Name="{Binding AccessibleName}">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Path Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource SecondaryLabelBrush}" StrokeThickness="1.2"
              StrokeLineCap="Round" StrokeJoin="Round"
              Data="M3.5,2.5 L12.5,2.5 A2,2 0 0 1 14.5,4.5 L14.5,11.5 A2,2 0 0 1 12.5,13.5 L3.5,13.5 A2,2 0 0 1 1.5,11.5 L1.5,4.5 A2,2 0 0 1 3.5,2.5 Z M4.5,6.5 L6.5,8 L4.5,9.5 M8,10 L11.5,10" />
        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource SmallSize}" VerticalAlignment="Center" Margin="0,0,2,0" />
        <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center" IsVisible="{Binding HasEnvironment}"
                Background="{DynamicResource FillBrush}" Classes.production="{Binding IsProduction}">
          <TextBlock Text="{Binding EnvironmentLabel}" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.5"
                     Foreground="{DynamicResource SecondaryLabelBrush}" Classes.production="{Binding IsProduction}" />
        </Border>
      </StackPanel>
    </Border>
  </DataTemplate>

  <ItemsPanelTemplate x:Key="ChipsPanel">
    <WrapPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>
</ResourceDictionary>
