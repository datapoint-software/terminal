<!-- Buttons, fields, lists and the segmented control, styled after macOS: flat, rounded, one prominent action. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    <Setter Property="Icon" Value="avares://Datapoint.Terminal/Assets/terminal-icon.png" />
  </Style>

  <!-- Buttons: secondary (grey fill) by default, .primary for the one action, .plain and .icon for toolbar buttons. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="{StaticResource ButtonHeight}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledLabelBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <Style Selector="Button.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.plain.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.plain.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.plain:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- A spinner's arc turns while the spinner is shown and motion isn't reduced (Components/Spinner.cs). -->
  <Style Selector="Arc.spinner.turning">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="{StaticResource RowHeight}" />
    <Setter Property="Height" Value="{StaticResource RowHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- A whole row that acts as a button, such as a sidebar row or a card's header: flat until the pointer is over it. -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="{StaticResource RowHeight}" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
  </Style>
  <Style Selector="Button PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!-- Text fields: a hairline border that turns accent when focused. -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="{StaticResource FieldHeight}" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="AutoCompleteBox">
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="AutoCompleteBox TextBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="AutoCompleteBox TextBox /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="AutoCompleteBox TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="AutoCompleteBox:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource SmallSize}" />
  </Style>

  <!-- A text box that reads as the text around it: no field, no padding, in every state. -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement, TextBox.bare:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Switches here never show On or Off beside them, but Fluent keeps 12 points for that text after the switch; without them,
       a switch lines up on the right with the fields and buttons in the rows around it. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Margin" Value="0,0,-12,0" />
  </Style>

  <!-- Segmented control: a ListBox with the .segmented class. -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource SmallSize}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegmentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegmentBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegmentBrush}" />
  </Style>

  <!-- A quiet pop-up menu, as macOS draws them in toolbars. -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="FontSize" Value="{StaticResource SmallSize}" />
    <Setter Property="MinHeight" Value="{StaticResource ButtonHeight}" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="ComboBox.quiet">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox.quiet:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- A list of rows, as in a macOS sidebar: rounded, the selection a tint of the accent. -->
  <Style Selector="ListBox.source">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.source ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="{StaticResource RowHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.source ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
  </Style>
  <Style Selector="ListBox.source ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
  </Style>
  <Style Selector="ListBox.source ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.source ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.source ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
</Styles>
