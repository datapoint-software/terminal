<!-- Menus, drop-downs and tooltips: one surface for all of them, a card with a hairline border, and rows inset from its edge
     so a highlighted row reads as a rounded pill, as on macOS. The Fluent theme's sizes are replaced through its own resource
     keys, so its templates stay as they are. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
    <Thickness x:Key="FlyoutBorderThemePadding">0</Thickness>
    <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,4</Thickness>
    <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
    <x:Double x:Key="MenuFlyoutSeparatorThemeHeight">1</x:Double>
    <Thickness x:Key="MenuFlyoutSeparatorThemePadding">8,4</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>
    <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
    <Thickness x:Key="ComboBoxItemThemePadding">8,4</Thickness>
    <Thickness x:Key="ToolTipBorderThemePadding">8,4</Thickness>
    <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>
  </Styles.Resources>

  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinWidth" Value="160" />
  </Style>
  <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator, MenuItem Separator">
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    <Setter Property="MinHeight" Value="{StaticResource ButtonHeight}" />
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
  </Style>
  <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DisabledLabelBrush}" />
  </Style>

  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
    <Setter Property="FontSize" Value="{StaticResource SmallSize}" />
    <Setter Property="MinHeight" Value="{StaticResource ButtonHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <!-- The Fluent theme's own fade ignores the reduce motion setting; OverlayMotion fades tooltips in when it may. -->
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
</Styles>
