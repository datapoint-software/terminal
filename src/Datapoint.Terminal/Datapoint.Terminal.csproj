<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Datapoint.Terminal</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- [LibraryImport] for asking the operating system to draw attention to a window. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <!-- Shown in the About window (AboutInfo); the AGPL asks the application to show its license. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Datapoint.Terminal.Legal.LICENSE" />
    <EmbeddedResource Include="..\..\NOTICE" LogicalName="Datapoint.Terminal.Legal.NOTICE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="Datapoint.Terminal.Legal.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Datapoint.Terminal.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Datapoint.Terminal.Emulator\Datapoint.Terminal.Emulator.csproj" />
    <ProjectReference Include="..\Datapoint.Terminal.Controls\Datapoint.Terminal.Controls.csproj" />
    <ProjectReference Include="..\Datapoint.Terminal.Sessions\Datapoint.Terminal.Sessions.csproj" />
    <ProjectReference Include="..\Datapoint.Terminal.Agent\Datapoint.Terminal.Agent.csproj" />
    <ProjectReference Include="..\Datapoint.Terminal.Security\Datapoint.Terminal.Security.csproj" />
  </ItemGroup>
</Project>
